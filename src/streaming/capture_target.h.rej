 /** @file src/streaming/capture_target.h
- * @brief Display actually captured by one video session, read by control requests.
+ * @brief Display (or window) actually captured by one video session, read and
+ *        controlled by local control requests.
+ *
+ * Plan4 extension: each video session carries a @ref capture_target_t that is
+ * shared between the streaming session and the capture/display backend (through
+ * @c video::config_t::capture_target).  A local control endpoint can therefore
+ * request "follow this window instead of the whole display" for exactly one
+ * session without touching the global Sunshine configuration.  The capture
+ * thread observes @ref capture_target_t::window_override_generation and
+ * reinitializes its display backend when the request changes.
  */
 #pragma once
 
+#include <atomic>
+#include <chrono>
+#include <cstdint>
 #include <memory>
 #include <mutex>
 #include <string>
 #include <string_view>
+#include <utility>
 #include <vector>
 
 namespace streaming {
+  /**
+   * @brief How the window-follow override resolves its capture target.
+   */
+  enum class window_capture_mode_e : int {
+    foreground = 0,  ///< Follow the current foreground top-level window.
+    title = 1,       ///< Follow the first window matching a case-insensitive title substring.
+    pid = 2,         ///< Follow the first eligible window owned by the given process id.
+  };
+
+  /**
+   * @brief Per-session request to capture a single window instead of a display.
+   *
+   * Disabled by default; existing sessions and the global
+   * @c config::video.capture / @c capture_target settings keep their old
+   * behaviour unless a control client explicitly enables this override.
+   */
+  struct window_capture_override_t {
+    bool enabled { false };
+    window_capture_mode_e mode { window_capture_mode_e::foreground };
+    std::string window_title;
+    std::uint32_t process_id { 0 };
+
+    static window_capture_override_t
+    foreground() {
+      window_capture_override_t result;
+      result.enabled = true;
+      result.mode = window_capture_mode_e::foreground;
+      return result;
+    }
+
+    static window_capture_override_t
+    by_title(std::string title) {
+      window_capture_override_t result;
+      result.enabled = true;
+      result.mode = window_capture_mode_e::title;
+      result.window_title = std::move(title);
+      return result;
+    }
+
+    static window_capture_override_t
+    by_pid(std::uint32_t pid) {
+      window_capture_override_t result;
+      result.enabled = true;
+      result.mode = window_capture_mode_e::pid;
+      result.process_id = pid;
+      return result;
+    }
+  };
+
+  /**
+   * @brief What the capture backend actually did with the override request.
+   *
+   * Written by the Windows WGC backend; read back by control/status requests so
+   * clients can tell the difference between "requested" and "applied".
+   */
+  struct window_capture_observed_t {
+    bool active { false };               ///< Capturing a window (true) or falling back to the display (false).
+    bool fallback_to_display { false };  ///< Display capture fallback while a window override is enabled.
+    std::string window_title;            ///< Actual captured window title.
+    std::uint32_t process_id { 0 };      ///< Owning process id of the captured window.
+    std::uint64_t hwnd { 0 };            ///< Raw HWND value (diagnostics only).
+    std::string fallback_reason;         ///< Non-empty when the override could not be applied.
+  };
+
   class capture_target_t {
   public:
     void
@@ -24,9 +101,89 @@ namespace streaming {
       return display_name_;
     }
 
+    /**
+     * @brief Install (or update) the window-follow override for this session.
+     *        Bumps @ref window_override_generation so the capture thread knows
+     *        to reinitialize its display backend.
+     */
+    void
+    set_window_override(window_capture_override_t override) {
+      std::lock_guard lock { mutex_ };
+      window_override_ = std::move(override);
+      window_override_enabled_at_unix_ms_ = window_override_.enabled ? unix_time_ms_now() : 0;
+      observed_ = {};
+      window_override_generation_.fetch_add(1, std::memory_order_acq_rel);
+    }
+
+    void
+    clear_window_override() {
+      set_window_override(window_capture_override_t {});
+    }
+
+    window_capture_override_t
+    window_override() const {
+      std::lock_guard lock { mutex_ };
+      return window_override_;
+    }
+
+    bool
+    window_override_enabled() const {
+      std::lock_guard lock { mutex_ };
+      return window_override_.enabled;
+    }
+
+    /**
+     * @brief Monotonic generation of the override configuration.
+     *
+     * Capture threads compare this value against their last observed value and
+     * reinitialize the display backend when it changes.
+     */
+    std::uint64_t
+    window_override_generation() const {
+      return window_override_generation_.load(std::memory_order_acquire);
+    }
+
+    void
+    set_observed_window(window_capture_observed_t observed) {
+      std::lock_guard lock { mutex_ };
+      observed_ = std::move(observed);
+    }
+
+    window_capture_observed_t
+    observed_window() const {
+      std::lock_guard lock { mutex_ };
+      return observed_;
+    }
+
+    /**
+     * @brief Unix-epoch milliseconds when the current window override was
+     *        enabled, or 0 when it is disabled.
+     *
+     * The Windows capture backend uses this as a lower bound when deciding
+     * which foreground windows may be followed: the Sunshine-launched app
+     * process tree plus processes started around/after this moment. This keeps
+     * a game-exit transient from switching the stream to an unrelated app.
+     */
+    std::int64_t
+    window_override_enabled_at_unix_ms() const {
+      std::lock_guard lock { mutex_ };
+      return window_override_enabled_at_unix_ms_;
+    }
+
   private:
+    static std::int64_t
+    unix_time_ms_now() {
+      return std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::system_clock::now().time_since_epoch())
+        .count();
+    }
+
     mutable std::mutex mutex_;
     std::string display_name_;
+    window_capture_override_t window_override_;
+    window_capture_observed_t observed_;
+    std::int64_t window_override_enabled_at_unix_ms_ { 0 };
+    std::atomic<std::uint64_t> window_override_generation_ { 0 };
   };
 
   struct capture_session_t {
