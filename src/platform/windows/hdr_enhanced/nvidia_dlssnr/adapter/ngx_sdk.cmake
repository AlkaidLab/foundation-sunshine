# The signed NR snippet does not export parameter allocation. Use the public
# NGX core SDK for that service, while Feature 18 remains runtime-loaded.
set(SUNSHINE_DLSS_SDK_ROOT "" CACHE PATH "Local NVIDIA DLSS SDK; empty downloads pinned build inputs")
set(_ngx_download_missing OFF)
if (NOT SUNSHINE_DLSS_SDK_ROOT)
  set(SUNSHINE_DLSS_SDK_ROOT "${CMAKE_CURRENT_BINARY_DIR}/ngx-sdk")
  set(_ngx_download_missing ON)
endif ()
set(_ngx_revision "374959484e79a640feaba44c93ac8cfb0a03f5b5")
function(_ngx_require path digest)
  set(destination "${SUNSHINE_DLSS_SDK_ROOT}/${path}")
  if (EXISTS "${destination}")
    file(SHA256 "${destination}" actual)
    if (actual STREQUAL digest)
      return()
    endif ()
  endif ()
  if (NOT _ngx_download_missing)
    message(FATAL_ERROR "DLSS SDK file missing or SHA-256 mismatch: ${destination}")
  endif ()
  get_filename_component(directory "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(DOWNLOAD
    "https://raw.githubusercontent.com/NVIDIA/DLSS/${_ngx_revision}/${path}"
    "${destination}" EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON TIMEOUT 45)
endfunction()
_ngx_require(include/nvsdk_ngx.h dc38e7467cf415379c9d12ae1b6e4a494c453ed92720fb53e92aecb523e7b848)
_ngx_require(include/nvsdk_ngx_defs.h ea23f33497cd274860d1c25a97644fce807dcb0037c594547203343103fad03e)
_ngx_require(include/nvsdk_ngx_params.h 943bc8cc5cdae03b6303016fbad3183636f2335ae27a2d18776798c3b4efabbc)
_ngx_require(lib/Windows_x86_64/x64/nvsdk_ngx_d.lib 4b6cecad7f1906571c94010241f650e4a5457e64fad49ddaccb82de79f6c2999)
_ngx_require(lib/Windows_x86_64/x64/nvsdk_ngx_d_dbg.lib 712f18162c8c8766c92c98031b52d2ba34ee0ad027ba79731278ee6b63cd3e02)
_ngx_require(LICENSE.txt d4216e39ebef5f9b50a6712ebb37beeb5379862a67733a9999c651f21592aaf0)
configure_file("${SUNSHINE_DLSS_SDK_ROOT}/LICENSE.txt" "${CMAKE_CURRENT_BINARY_DIR}/NVIDIA-DLSS-LICENSE.txt" COPYONLY)
add_library(dlssnr_ngx_sdk INTERFACE)
target_include_directories(dlssnr_ngx_sdk SYSTEM INTERFACE "${SUNSHINE_DLSS_SDK_ROOT}/include")
target_link_libraries(dlssnr_ngx_sdk INTERFACE
  "${SUNSHINE_DLSS_SDK_ROOT}/lib/Windows_x86_64/x64/nvsdk_ngx_d$<$<CONFIG:Debug>:_dbg>.lib")
