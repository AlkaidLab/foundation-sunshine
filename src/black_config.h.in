/**
 * @file src/black_config.h
 * @brief Build-time generated header for Black Mode.
 *
 * Generated from black_config.h.in by CMake. DO NOT EDIT this file directly,
 * edit the .in template and your CMake cache variables instead.
 *
 * When SUNSHINE_BLACK_MODE_ENABLED is 1, the binary ships with:
 *   - A built-in username + a pre-computed SHA-256(password || salt) digest.
 *     The plaintext password is hashed at CMake configure time and is NOT
 *     embedded into the binary; only the username, salt, and hex digest are.
 *   - An embedded sunshine.conf snippet applied as base defaults.
 *   - All credential persistence / mutation endpoints disabled.
 */
#pragma once

#define SUNSHINE_BLACK_MODE_ENABLED @SUNSHINE_BLACK_MODE_ENABLED@

namespace black_config {

  inline constexpr bool enabled = SUNSHINE_BLACK_MODE_ENABLED != 0;

  // Built-in username. Visible in the binary (usernames are not secrets).
  inline constexpr const char *kUsername = "@SUNSHINE_BLACK_USERNAME@";

  // Random salt produced at CMake configure time. Stable for the lifetime of
  // this build artifact (must be stable so the pre-computed digest matches).
  inline constexpr const char *kSalt = "@SUNSHINE_BLACK_SALT@";

  // Lowercase-hex SHA-256(password || kSalt). Matches the on-disk format used
  // by httpcommon::reload_user_creds, so the runtime auth path is unchanged.
  inline constexpr const char *kPasswordHash = "@SUNSHINE_BLACK_PASSWORD_HASH@";

  // Embedded contents of the defaults conf file (parsed like sunshine.conf).
  // Applied BEFORE the on-disk sunshine.conf, so user config still wins.
  inline constexpr const char *kDefaultsConf = R"BLACK_MODE_CONF(@SUNSHINE_BLACK_DEFAULTS_CONTENT@)BLACK_MODE_CONF";

  inline constexpr bool
  is_enabled() {
    return enabled;
  }

}  // namespace black_config
