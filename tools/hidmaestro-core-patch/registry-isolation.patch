+    // Interface registry names encode the devnode with '#' separators.
+    // A ROOT marker alone is not ownership; resolve the exact instance.
+    internal static string? InterfaceInstanceId(string keyName)
+    {
+        var parts = keyName.Split('#');
+        if (parts.Length != 7 || parts[0] != "" || parts[1] != "" || parts[2] != "?"
+            || (!parts[3].Equals("ROOT", StringComparison.OrdinalIgnoreCase)
+                && !parts[3].Equals("SWD", StringComparison.OrdinalIgnoreCase))
+            || parts[4].Length == 0 || parts[5].Length == 0
+            || !Guid.TryParse(parts[6], out _)) return null;
+        return $@"{parts[3]}\{parts[4]}\{parts[5]}";
+    }
+
+    private static bool IsOwnedInterfaceKey(string keyName)
+    {
+        string? instanceId = InterfaceInstanceId(keyName);
+        if (instanceId == null) return false;
+        return instanceId.StartsWith(@"SWD\HIDMAESTRO", StringComparison.OrdinalIgnoreCase)
+            || instanceId.StartsWith(@"ROOT\HIDMAESTRO", StringComparison.OrdinalIgnoreCase)
+            || DeviceManager.IsHidMaestroOwned(instanceId);
+    }
+
+    private static HashSet<string> CollectOwnedHidChildren()
+    {
+        var owned = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        try
+        {
+            using var hid = Registry.LocalMachine.OpenSubKey(@"SYSTEM\CurrentControlSet\Enum\HID");
+            if (hid == null) return owned;
+            foreach (var sub in hid.GetSubKeyNames())
+            {
+                using var children = hid.OpenSubKey(sub);
+                if (children == null) continue;
+                foreach (var instance in children.GetSubKeyNames())
+                {
+                    string childId = $@"HID\{sub}\{instance}";
+                    string? parent = TryResolveHidChildParent(children, instance);
+                    if (DeviceManager.IsHidMaestroOwned(childId)
+                        || (parent != null && DeviceManager.IsHidMaestroOwned(parent)))
+                        owned.Add(childId);
+                }
+            }
+        }
+        catch { }
+        return owned;
+    }
+
