<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared payload-policy model. Both the release audit tool and the Core
       payload builder must classify resources identically, so the glob rules
       and the deny-wins ordering live here once. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PayloadPolicy</AssemblyName>
    <RootNamespace>PayloadPolicy</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
