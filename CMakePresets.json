{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-win",
      "displayName": "Windows Dev (Ninja + MSYS2)",
      "description": "Local Windows development build. Run inside MSYS2 UCRT64 shell.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "BUILD_DOCS": "OFF",
        "SUNSHINE_ASSETS_DIR": "assets",
        "FETCH_DRIVER_DEPS": "OFF"
      }
    },
    {
      "name": "test-win",
      "inherits": "dev-win",
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": {
        "BUILD_TESTS": "ON",
        "BUILD_WEB_UI": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "displayName": "Dev Build",
      "configurePreset": "dev-win"
    },
    {
      "name": "test-win",
      "configurePreset": "test-win"
    }
  ],
  "testPresets": [
    {
      "name": "test-win",
      "configurePreset": "test-win",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
