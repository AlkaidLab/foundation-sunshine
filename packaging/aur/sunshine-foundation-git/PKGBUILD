# ---------------------------------------------------------------------------
# Submodule placement
# ---------------------------------------------------------------------------
# makepkg cannot check out gitlinks, so the sources above are unpacked into
# $srcdir under their basename. This list maps each of those directory names
# back to its path inside the repository.
_submodule_paths=(
  'packaging/linux/flatpak/deps/flatpak-builder-tools'
  'packaging/linux/flatpak/deps/shared-modules'
  'src_assets/common/sunshine-control-panel'
  'third-party/AMF'
  'third-party/Simple-Web-Server'
  'third-party/TPCircularBuffer'
  'third-party/ViGEmClient'
  'third-party/build-deps'
  'third-party/doxyconfig'
  'third-party/googletest'
  'third-party/inputtino'
  'third-party/moonlight-audio-haptics'
  'third-party/moonlight-common-c'
  'third-party/nanors'
  'third-party/nvapi'
  'third-party/nvenc-headers/1100'
  'third-party/nvenc-headers/1200'
  'third-party/nvenc-headers/1300'
  'third-party/nvenc-headers/1301'
  'third-party/tray'
  'third-party/wayland-protocols'
  'third-party/wlr-protocols'
  'third-party/doxyconfig/doxygen-awesome-css'
  'third-party/moonlight-common-c/enet'
  'third-party/moonlight-common-c/nanors'
  'third-party/tray/third-party/doxyconfig'
  'third-party/tray/third-party/googletest'
  'third-party/tray/third-party/lizardbyte-common'
)

# Only these differ from their source basename (source= supports a `name::url`
# prefix, but the prefix must be unique, so the duplicates get a suffix).
_submodule_srcname() {
  case "$1" in
    third-party/build-deps) printf 'foundation-build-deps' ;;
    third-party/nvenc-headers/1100) printf 'nv-codec-headers-1100' ;;
    third-party/nvenc-headers/1200) printf 'nv-codec-headers-1200' ;;
    third-party/nvenc-headers/1300) printf 'nv-codec-headers-1300' ;;
    third-party/nvenc-headers/1301) printf 'nv-codec-headers-1301' ;;
    third-party/moonlight-common-c/nanors) printf 'moonlight-common-c-nanors' ;;
    third-party/tray/third-party/doxyconfig) printf 'tray-doxyconfig' ;;
    third-party/tray/third-party/googletest) printf 'tray-googletest' ;;
    *) printf '%s' "${1##*/}" ;;
  esac
}

pkgver() {
  cd "$srcdir/foundation-sunshine"

  # v0.9.1-linux-full-cross-product -> 0.9.1, then .r<commit count>.g<short sha>
  local base
  base="$(git describe --long --tags --match 'v[0-9]*' 2>/dev/null | sed -E 's/^v//; s/^([0-9]+\.[0-9]+\.[0-9]+).*/\1/')"
  [ -n "$base" ] || base=0

  printf '%s.r%s.g%s' \
    "$base" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=8 HEAD)"
}

prepare() {
  cd "$srcdir/foundation-sunshine"

  # The gitlink directories exist (empty) after makepkg's checkout; replace
  # each with the corresponding pre-fetched source tree.
  local path src
  for path in "${_submodule_paths[@]}"; do
    src="$srcdir/$(_submodule_srcname "$path")"
    if [ ! -d "$src" ]; then
      error "Submodule source for %s not found (%s)" "$path" "$src"
      return 1
    fi
    rm -rf -- "$path"
    mkdir -p -- "$(dirname "$path")"
    cp -a -- "$src" "$path"
  done

  # AMF and build-deps are huge checkouts of which Linux uses a slice. Reduce
  # them with sparse-checkout when the source is a git repo (it always is).
  #
  # AMF is Windows-only (~1.2 GB); Linux needs nothing from it, but the
  # gitlink stays present so the tree matches .gitmodules.
  if [ -d third-party/AMF/.git ]; then
    if git -C third-party/AMF sparse-checkout set amf/public/include 2>/dev/null; then
      rm -rf -- third-party/AMF/amf
      git -C third-party/AMF checkout -- .
    fi
  fi

  # build-deps ships pre-built FFmpeg/x264/x265/SVT-AV1/hdr10plus per platform;
  # keep only this machine's slice (~66 MB instead of ~600 MB). If the path
  # does not exist the full tree is used, so this cannot break the build.
  local arch_slice
  case "$(uname -m)" in
    x86_64) arch_slice=Linux-x86_64 ;;
    aarch64) arch_slice=Linux-aarch64 ;;
    *) arch_slice="" ;;
  esac
  if [ -n "$arch_slice" ] && [ -d "third-party/build-deps/dist/$arch_slice" ]; then
    if git -C third-party/build-deps sparse-checkout set "dist/$arch_slice" 2>/dev/null; then
      local keep
      for keep in third-party/build-deps/dist/*; do
        [ "$keep" = "third-party/build-deps/dist/$arch_slice" ] || rm -rf -- "$keep"
      done
      git -C third-party/build-deps checkout -- "dist/$arch_slice"
    fi
  fi

  # Deterministic web-UI dependencies; the ninja `web-ui` target also runs
  # `npm install` during build(), using this cache thanks to NPM_OFFLINE=ON.
  npm ci --no-audit --no-fund
}

build() {
  # CMAKE_BUILD_TYPE=Release supplies -O3; keep the Arch flags for hardening
  # (-fno-plt, -fexceptions, relro/now) but drop -Werror=format-security, which
  # upstream also strips.
  export CFLAGS="${CFLAGS/-Werror=format-security/}"
  export CXXFLAGS="${CXXFLAGS/-Werror=format-security/}"

  local _cmake_options=(
    -S foundation-sunshine
    -B build
    -G Ninja
    -Wno-dev
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
    -D SUNSHINE_ASSETS_DIR=share/sunshine
    -D SUNSHINE_EXECUTABLE_PATH=/usr/bin/sunshine
    -D SUNSHINE_PUBLISHER_NAME='QiE2035'
    -D SUNSHINE_PUBLISHER_WEBSITE='https://github.com/AlkaidLab/foundation-sunshine'
    -D SUNSHINE_PUBLISHER_ISSUE_URL='https://github.com/AlkaidLab/foundation-sunshine/issues'
    -D NPM_OFFLINE=ON
    -D BUILD_DOCS=OFF
    -D BUILD_TESTS=OFF
  )

  if [ "$_use_cuda" = true ]; then
    _cmake_options+=(-D SUNSHINE_ENABLE_CUDA=ON)
  else
    _cmake_options+=(-D SUNSHINE_ENABLE_CUDA=OFF -D CUDA_FAIL_ON_MISSING=OFF)
  fi

  cmake "${_cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
