# Maintainer: QiE2035 <qie2035@users.noreply.github.com>
#
# AUR package for AlkaidLab/qiin2333 "Foundation Sunshine" — the fork of
# LizardByte/Sunshine carrying the Windows feature set, ported to Linux
# (KDE Plasma/Wayland, niri, PipeWire/PulseAudio, VDD via EDID override).
# Upstream project: https://github.com/AlkaidLab/foundation-sunshine
#
# This package compiles from source. It tracks the `linux-migration` branch,
# because that is where all Linux work lands in this fork. To freeze a build,
# change the `#branch=linux-migration` fragment below to
# `#commit=<40-char sha>` and bump pkgver/pkgrel.
#
# ---------------------------------------------------------------------------
# Build notes (things that bite)
# ---------------------------------------------------------------------------
# * Boost is pinned to an EXACT version by cmake/dependencies/Boost_Sunshine.cmake
#   (`find_package(Boost CONFIG ${BOOST_VERSION} EXACT ...)`). If the Arch boost
#   package is not that exact version, CMake silently falls back to downloading
#   and building Boost from GitHub (FetchContent) — which breaks the "no network
#   in build()" rule and makes the build slow. Bump `_boost_version` in sync
#   with Arch's boost package, and bump the `boost=$_boost_version` depends
#   entry with it.
#   Same idea for nlohmann_json (>= 3.12): without the system package it is
#   fetched. `nlohmann-json` is a makedepends so the system copy wins.
# * The web UI is built by ninja (`web-ui` ALL target) and needs npm at build
#   time. `npm ci` runs once in prepare(); `NPM_OFFLINE=ON` makes the npm
#   invocation inside the build use that already-populated cache.
# * FFmpeg plus x264/x265/SVT-AV1/hdr10plus are consumed as pre-built static
#   archives from `third-party/build-deps/dist/Linux-<arch>` (submodule). No
#   system ffmpeg is required or used.
# * CUDA/NVENC is disabled by default; flip `_use_cuda` to true (and add `cuda`
#   to makedepends) to build it. VAAPI (AMD/Intel) and the software encoder are
#   always built.
# * options=(!strip): makepkg's strip would drop the installed file
#   capabilities that post_install sets. Sunshine needs cap_sys_admin (KMS
#   capture) + cap_dac_read_search/cap_dac_override (DRM connector EDID/status
#   under /sys/kernel/debug) + cap_sys_ptrace (borrow the compositor's DRM
#   master for virtual-display CRTC assignment).
# * Nested submodules (third-party/{doxyconfig,moonlight-common-c,tray}) are
#   declared below as well; their SHAs are pinned in the parent gitlink, so they
#   are only re-pinned when the parent commit changes.
# ---------------------------------------------------------------------------

pkgname=sunshine-foundation-git
pkgver=0.9.1.r68.g6c2123f8
pkgrel=1
pkgdesc="Self-hosted game stream host for Moonlight (AlkaidLab/qiin2333 fork, Linux migration branch)"
arch=('x86_64' 'aarch64')
url="https://github.com/AlkaidLab/foundation-sunshine"
license=('GPL-3.0-only')
install="$pkgname.install"

# Set to true to build with CUDA/NVENC support. That adds a hard `cuda`
# makedepends; VAAPI (AMD/Intel) and the software encoder are always built.
_use_cuda=false

# Keep in sync with cmake/dependencies/Boost_Sunshine.cmake
_boost_version=1.92.0

depends=(
  "boost=$_boost_version"
  "boost-libs=$_boost_version"
  'curl'
  'gcc-libs'
  'libcap'
  'libdrm'
  'libevdev'
  'libglvnd'   # libEGL / libGLdispatch (KMS + Wayland capture)
  'libnotify'
  'libpulse'
  'libva'
  'libx11'
  'miniupnpc'
  'numactl'
  'openssl'
  'opus'
  'qt6-base'
  'qt6-svg'
  'systemd'
  'udev'
  'wayland'
)

makedepends=(
  'boost'          # headers (the exact-version CONFIG package)
  'cmake'
  'git'
  'nlohmann-json'  # >= 3.12, avoids a FetchContent download
  'nodejs'
  'npm'
  'pkgconf'
)

optdepends=(
  'cuda: NVENC hardware encoding on NVIDIA (rebuild with -DSUNSHINE_ENABLE_CUDA=ON)'
  'libva-intel-driver: VAAPI encoding on older Intel GPUs'
  'libva-mesa-driver: VAAPI encoding on AMD/Intel'
  'nvidia-utils: NVENC/NVDEC driver stack'
)

provides=('sunshine')
conflicts=('sunshine' 'sunshine-git' 'sunshine-bin')
options=(!strip)

# `source` mirrors the repository's gitlinks, including nested submodules.
