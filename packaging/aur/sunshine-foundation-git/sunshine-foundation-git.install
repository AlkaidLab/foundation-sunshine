post_install() {
  _sunshine_setcap
  _sunshine_udev_reload
  _sunshine_input_group_hint

  echo ":: Foundation Sunshine (linux-migration) installed."
  echo "   Start:    systemctl --user enable --now sunshine"
  echo "   Or run:   sunshine"
  echo "   Web UI:   https://localhost:47990   (settings live in ~/.config/sunshine)"
  echo
  echo "NOTE: KDE Plasma / niri on Wayland and the virtual display need the"
  echo "      file capabilities set below. Re-run this hook after reinstalling"
  echo "      or if the binary is ever replaced without them:"
  echo "        setcap cap_sys_admin,cap_dac_read_search,cap_dac_override,cap_sys_ptrace+p /usr/bin/sunshine"
}

post_upgrade() {
  post_install
}

pre_remove() {
  :
}

post_remove() {
  echo ":: Sunshine removed."
  echo "   Note: the user may still be a member of the 'input' group."
  echo "   To remove them manually: sudo gpasswd -d <username> input"
}

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

_sunshine_binary() {
  # /usr/bin/sunshine is a symlink to sunshine-<version>; resolve it so the
  # capabilities land on the real inode.
  readlink -f /usr/bin/sunshine 2>/dev/null || printf '/usr/bin/sunshine'
}

_sunshine_setcap() {
  local binary
  binary="$(_sunshine_binary)"

  # cap_sys_admin:        KMS/DRM capture
  # cap_dac_read_search:  read connector EDID overrides under /sys/kernel/debug
  # cap_dac_override:     write DRM connector status (virtual display)
  # cap_sys_ptrace:       borrow the compositor's DRM master (pidfd_getfd) so the
  #                       VDD CRTC can be assigned
  if ! command -v setcap >/dev/null 2>&1; then
    echo "WARNING: setcap not found (install libcap) - Sunshine will not be able to capture the screen." >&2
    return 0
  fi

  if [ ! -e "$binary" ]; then
    echo "WARNING: $binary not found - skipping setcap." >&2
    return 0
  fi

  setcap cap_sys_admin,cap_dac_read_search,cap_dac_override,cap_sys_ptrace+p "$binary" || \
    echo "WARNING: setcap failed on $binary." >&2
}

_sunshine_udev_reload() {
  # The packaged udev rule tags /dev/uinput and /dev/uhid with uaccess AND
  # assigns them to the 'input' group with mode 0660. This covers both local
  # sessions (uaccess ACL) and SSH-started user services (static group perms).
  # Load the modules first so the device nodes exist before triggering.
  modprobe uinput 2>/dev/null || :
  modprobe uhid 2>/dev/null || :

  if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules
    udevadm trigger --property-match=DEVNAME=/dev/uinput
    udevadm trigger --property-match=DEVNAME=/dev/uhid
  fi
}

_sunshine_input_group_hint() {
  # The udev rule above already grants the active seat session access through
  # TAG+="uaccess", which is what a desktop user needs. Membership in the
  # 'input' group is only needed for sessions logind does not attach to a seat
  # (SSH, headless services), and it is a permanent grant over every input
  # device on the machine - so it stays a deliberate, manual step.
  local target_user="${SUDO_USER:-}"

  if [ -z "$target_user" ] || ! id "$target_user" &>/dev/null; then
    return 0
  fi

  if id -nG "$target_user" | grep -qw "input"; then
    return 0
  fi

  echo "NOTE: '$target_user' is not in the 'input' group."
  echo "      Desktop (seat) sessions do not need it - the udev rule grants"
  echo "      access through uaccess. Enable it only for SSH or headless use:"
  echo "        sudo usermod -aG input $target_user"
  echo "      Then log out and back in for it to take effect."
}
