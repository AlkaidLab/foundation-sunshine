[Code]
// =============================================================================
// Pascal Script for custom behavior
// =============================================================================

// =============================================================================
// Deep UI Customization — Sunshine Branded Installer Theme
// =============================================================================
// Color palette (BGR format for Delphi):
//   Brand Gold:     $0098E8  (RGB #E89800)  — primary accent
//   Brand Orange:   $0060C0  (RGB #C06000)  — headings
//   Dark Text:      $1A1A1A  (RGB #1A1A1A)  — body text
//   Mid Text:       $444444  (RGB #444444)  — secondary text
//   Light BG:       $FAF6F2  (RGB #F2F6FA)  — warm tint background
//   Inner BG:       $F5F2EF  (RGB #EFF2F5)  — inner panel bg
//   Header BG:      $A86420  (RGB #2064A8)  — header band color
//   Accent Line:    $0088D8  (RGB #D88800)  — accent bar

var
  BrandPanel: TPanel;
  BrandLogo: TBitmapImage;
  BrandTitle: TNewStaticText;
  BrandSubtitle: TNewStaticText;
  AccentBar: TBevel;
  ExistingInnoInstall: Boolean;
  // Set when VerifyServiceInstalled() could not confirm the SunshineService
  // registration. Surfaced through GetCustomSetupExitCode() so unattended
  // callers still see a failure — the GUI updater runs us with /VERYSILENT
  // and treats exit code 0 as "update installed successfully".
  ServiceVerifyFailed: Boolean;
  // Starting now is independent of registration and the user's boot setting.
  ServiceStartFailed: Boolean;
  PermissionsRepairInProgress: Boolean;
  // 0 = ready/not selected, 101 = failed, 3010 = reboot required.
  VDDResultCode: Integer;
  InstallRunDir: String;
  InstallRunId: String;
  InstallEventSequence: Integer;
  InstallProgressPermille: Integer;
  GamepadResult, UsbipResult: Integer;
  RebootChecked: Boolean;
  RebootReasons: String;
  // the journal the host reports at its next start (JournalWrite below)
  JournalRun, PreviousVersion: String;
  // The Web UI folder moved aside before the files are copied (BackUpWebUi), and whether the
  // installation got as far as its post-install step: only then is the new folder the one to keep.
  WebUiMovedAside, PostInstallReached, UpdateScriptExtracted, ServiceStoppedForUpdate: Boolean;
  // The folder this run prepared for the update (programs moved aside, Web UI folder moved aside).
  // Empty until PrepareToInstall prepared one, so a run that is cancelled before that touches nothing;
  // kept as text because the wizard lets the person go back and choose another folder.
  UpdateAppDir: String;
  // The marker could not be written (a scanner refused the file) although every file was copied.
  WebUiMarkerFailed: Boolean;

function InstallerMessageBox(const Text: String; const Typ: TMsgBoxType;
  const Buttons, DefaultAnswer: Integer): Integer;
var
  Silent: Boolean;
begin
  // Authority: installer-inno-suppressible-msgbox-20261118 (Description),
  // installer-inno-silent-state-20261118, installer-inno-uninstall-state-20261118
  // and installer-inno-is-uninstaller-20261118 (Description).
  // /SILENT alone does not suppress script dialogs. Never require a desktop
  // response in either silent mode; otherwise keep the original interactive UI.
  if IsUninstaller then
    Silent := UninstallSilent
  else
    Silent := WizardSilent;
  if Silent then
    Result := DefaultAnswer
  else
    Result := SuppressibleMsgBox(Text, Typ, Buttons, DefaultAnswer);
end;

function InstallerParameterValue(Name: String): String;
// Authority: installer-inno-script-functions-20261107 (GetCmdTail,
// SaveStringToFile); installer-inno-command-line-20261107 (silent switches).
var
  Tail, UpperTail, UpperNeedle: String;
  StartPos, EndPos: Integer;
begin
  Result := '';
  Tail := GetCmdTail();
  UpperTail := Uppercase(Tail);
  UpperNeedle := Uppercase('/' + Name + '=');
  StartPos := Pos(UpperNeedle, UpperTail);
  if StartPos = 0 then
    Exit;
  StartPos := StartPos + Length(UpperNeedle);
  EndPos := StartPos;
  while (EndPos <= Length(Tail)) and (Tail[EndPos] <> ' ') and (Tail[EndPos] <> #9) do
    EndPos := EndPos + 1;
  Result := Copy(Tail, StartPos, EndPos - StartPos);
  if (Length(Result) >= 2) and (Result[1] = '"') and (Result[Length(Result)] = '"') then
    Result := Copy(Result, 2, Length(Result) - 2);
end;

procedure EmitInstallerEvent(Phase, State, MessageKey: String; ResultCode: Integer);
var
  Line: String;
begin
  if InstallRunDir = '' then
    Exit;
  InstallEventSequence := InstallEventSequence + 1;
  Line := '{"schema":1,"run":"' + InstallRunId + '","seq":' + IntToStr(InstallEventSequence) +
          ',"phase":"' + Phase + '","state":"' + State + '","result_code":' + IntToStr(ResultCode) +
          ',"message_key":"' + MessageKey + '"}' + #13#10;
  SaveStringToFile(AddBackslash(InstallRunDir) + 'events.jsonl', AnsiString(Line), True);
end;

// The journal the host reads at its next start and reports (src/telemetry/install_journal.h): one JSON line per step of this run in <app>\config\telemetry\install_journal.jsonl.
// Only numbers and fixed words go in. Component and step names are literals of this script and the previous version is reduced to digits and dots; no path and no text of an error.
procedure JournalWrite(Line: String);
var
  Dir: String;
begin
  Dir := ExpandConstant('{app}\config\telemetry');
  if not ForceDirectories(Dir) then
    Exit;
  SaveStringToFile(AddBackslash(Dir) + 'install_journal.jsonl', AnsiString(Line + #13#10), True);
end;

function JournalRunId(): String;
begin
  if JournalRun = '' then
    JournalRun := GetDateTimeString('yyyymmddhhnnss', #0, #0);
  Result := JournalRun;
end;

function DigitsAndDots(Value: String): String;
var
  I: Integer;
begin
  Result := '';
  for I := 1 to Length(Value) do
    if ((Value[I] >= '0') and (Value[I] <= '9')) or (Value[I] = '.') then
      Result := Result + Value[I];
end;

procedure JournalStart();
var
  Phase: String;
begin
  if ExistingInnoInstall then
    Phase := 'upgrade'
  else
    Phase := 'install';
  JournalWrite('{"v":1,"kind":"start","run":"' + JournalRunId() + '","phase":"' + Phase + '","from":"' + DigitsAndDots(PreviousVersion) + '"}');
end;

procedure JournalComponent(Component, Step: String; ExitCode: Integer);
begin
  JournalWrite('{"v":1,"kind":"component","run":"' + JournalRunId() + '","component":"' + Component + '","step":"' + Step + '","exit":' + IntToStr(ExitCode) + '}');
end;

// The USB/IP wrapper records only fixed step names and numeric codes. When the component failed, read them before deleting the file so a failure in the
// bundled installer is distinguishable from a guard failure, without copying any output. A component that worked adds nothing (one event per step would
// only repeat "ok"). Source: installer-inno-script-functions-20261107.
procedure JournalUsbipDetails(ComponentResult: Integer);
var
  Path, Line, Step, CodeText: String;
  Lines: TArrayOfString;
  I, EqualsAt, Code: Integer;
begin
  Path := ExpandConstant('{app}\scripts\result-usbip-steps.txt');
  if not FileExists(Path) then
    Exit;
  if (ComponentResult <> 0) and (ComponentResult <> 3010) and LoadStringsFromFile(Path, Lines) then
    for I := 0 to GetArrayLength(Lines) - 1 do
    begin
      Line := Trim(Lines[I]);
      EqualsAt := Pos('=', Line);
      if EqualsAt <= 1 then
        Continue;
      Step := Copy(Line, 1, EqualsAt - 1);
      CodeText := Copy(Line, EqualsAt + 1, Length(Line));
      if not ((Step = 'payload') or (Step = 'guard') or (Step = 'preflight') or (Step = 'snapshot') or
        (Step = 'installer') or (Step = 'installer_retry') or (Step = 'verify')) then
        Continue;
      Code := StrToIntDef(CodeText, -1);
      JournalComponent('usbip', Step, Code);
    end;
  DeleteFile(Path);
end;

procedure JournalFinish(ExitCode: Integer);
begin
  JournalWrite('{"v":1,"kind":"finish","run":"' + JournalRunId() + '","exit":' + IntToStr(ExitCode) + '}');
end;

// The steps this run takes, for the shell's overall progress (the 'plan' event; step ids as the shell names them).
// Optional steps that only run when needed (permissions repair, removals) are not planned; the shell adds a step
// that reports without being planned.
function PlannedInstallerSteps(): String;
begin
  Result := 'worker,engine,wizard,prepare,files,path,config';
  if WizardIsComponentSelected('vdd') then Result := Result + ',vdd';
  if WizardIsComponentSelected('gamepad') then Result := Result + ',gamepad';
  if WizardIsComponentSelected('usbip') then Result := Result + ',usbip';
  if WizardIsComponentSelected('vmouse') then Result := Result + ',vmouse';
  if WizardIsComponentSelected('firewall') then Result := Result + ',firewall';
  Result := Result + ',service';
  if WizardIsComponentSelected('autostart') then Result := Result + ',autostart';
end;

// Progress of the file copy as a 'permille' field on the running 'install' event, at most every 2 %.
// Authority: installer-inno-curinstallprogresschanged-20261109.
procedure CurInstallProgressChanged(CurProgress, MaxProgress: Integer);
var
  Permille: Integer;
begin
  if (InstallRunDir = '') or (MaxProgress <= 0) then
    Exit;
  Permille := Round((CurProgress * 1.0) / MaxProgress * 1000);
  if Permille > 1000 then Permille := 1000;
  if Permille < InstallProgressPermille + 20 then
    Exit;
  InstallProgressPermille := Permille;
  InstallEventSequence := InstallEventSequence + 1;
  SaveStringToFile(AddBackslash(InstallRunDir) + 'events.jsonl', AnsiString('{"schema":1,"run":"' + InstallRunId +
    '","seq":' + IntToStr(InstallEventSequence) + ',"phase":"install","state":"running","result_code":0,' +
    '"message_key":"InstallProgress","permille":' + IntToStr(Permille) + '}' + #13#10), True);
end;

// Phase events for the installer shell (one JSON line each; see EmitInstallerEvent). They only
// report progress; they do not change what the [Run] entries do or in which order.
procedure EvtPermissions(); begin PermissionsRepairInProgress := True; EmitInstallerEvent('permissions', 'running', 'StatusResetPermissions', 0); end;
function PermissionsRepairStarted(): Boolean; begin Result := PermissionsRepairInProgress; end;
procedure EvtPath(); begin EmitInstallerEvent('path', 'running', 'StatusUpdatePath', 0); end;
procedure EvtConfig(); begin EmitInstallerEvent('config', 'running', 'StatusMigrateConfig', 0); end;
procedure EvtFirewall(); begin DeleteFile(ExpandConstant('{app}\scripts\result-firewall.txt')); EmitInstallerEvent('firewall', 'running', 'StatusFirewall', 0); end;
procedure EvtGamepad(); begin EmitInstallerEvent('gamepad', 'running', 'StatusInstallGamepad', 0); end;
procedure EvtUsbip(); begin EmitInstallerEvent('usbip', 'running', 'StatusInstallUsbip', 0); end;

// The helper scripts leave their exit code in scripts\result-<name>.txt: 0 done, 3010 needs a restart, else failed.
function TakeStepResult(Name: String): Integer;
var
  Path: String;
  Lines: TArrayOfString;
begin
  Result := -1;
  Path := ExpandConstant('{app}\scripts\result-' + Name + '.txt');
  if FileExists(Path) then
  begin
    if LoadStringsFromFile(Path, Lines) and (GetArrayLength(Lines) > 0) then
      Result := StrToIntDef(Trim(Lines[0]), -1);
    DeleteFile(Path);
  end;
end;

procedure EmitStepResult(Phase, Key: String; Code: Integer);
begin
  if Code = 0 then
    EmitInstallerEvent(Phase, 'done', Key, 0)
  else if Code = 3010 then
    EmitInstallerEvent(Phase, 'needs-reboot', Key, 3010)
  else
    EmitInstallerEvent(Phase, 'failed', Key, Code);
end;

procedure EvtFirewallDone();
var
  ResultCode: Integer;
begin
  ResultCode := TakeStepResult('firewall');
  EmitStepResult('firewall', 'StatusFirewall', ResultCode);
  JournalComponent('firewall', 'install', ResultCode);
end;

procedure EvtGamepadDone();
begin
  GamepadResult := TakeStepResult('gamepad');
  EmitStepResult('gamepad', 'StatusInstallGamepad', GamepadResult);
  JournalComponent('gamepad', 'install', GamepadResult);
end;

procedure EvtUsbipDone();
begin
  UsbipResult := TakeStepResult('usbip');
  EmitStepResult('usbip', 'StatusInstallUsbip', UsbipResult);
  // 102 to 105 are the codes of the root-hub guard of the USB/IP component; -1: the helper left no result at all
  JournalUsbipDetails(UsbipResult);
  JournalComponent('usbip', 'install', UsbipResult);
end;

procedure EvtVmouse(); begin EmitInstallerEvent('vmouse', 'running', 'StatusInstallVmouse', 0); end;
procedure EvtVmouseDone(); begin EmitInstallerEvent('vmouse', 'done', 'StatusInstallVmouse', 0); end;
procedure EvtServiceStart(); begin DeleteFile(ExpandConstant('{app}\scripts\result-service.txt')); EmitInstallerEvent('service', 'running', 'StatusInstallService', 0); end;
procedure EvtAutostart(); begin DeleteFile(ExpandConstant('{app}\scripts\result-autostart.txt')); EmitInstallerEvent('autostart', 'running', 'StatusAutostart', 0); end;

function VDDComponentSelected(): Boolean;
begin
  Result := WizardIsComponentSelected('vdd');
end;

// install-usbip.bat exit codes 102..105: the root-hub guard rolled the install back, or refused it, or could not run (issue #1272).
// The controller node is then not registered either: there is no driver for it to bind.
function UsbipGuardTripped(): Boolean;
begin
  Result := (UsbipResult >= 102) and (UsbipResult <= 105);
end;

function ShouldRunUsbipRootInstall(): Boolean;
begin
  // An existing install must migrate even when the user changes optional
  // component selection during an upgrade. New installs only create the node
  // when the USB/IP component (usbip-win2) is selected.
  // usbip-win2 needs Windows 10 1903 (18362): an older system never gets the node, migration or not.
  Result := ((GetWindowsVersion and $FFFF) >= 18362) and (ExistingInnoInstall or WizardIsComponentSelected('usbip')) and
            (not UsbipGuardTripped());
end;

// Authority: installer-inno-components-params-20261107; installer-inno-uninstall-regkey-20261107.
function PreviousComponentSelected(Name: String): Boolean;
var
  Selected: String;
begin
  Result := RegQueryStringValue(HKLM64,
    'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{B16E5C0D-7B8A-4E3B-9F1A-2D4C6E8F0A1B}_is1',
    'Inno Setup: Selected Components', Selected);
  if not Result then
    Result := RegQueryStringValue(HKLM32,
      'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{B16E5C0D-7B8A-4E3B-9F1A-2D4C6E8F0A1B}_is1',
      'Inno Setup: Selected Components', Selected);
  Result := Result and (Pos(Lowercase(Name), Lowercase(Selected)) > 0);
end;

function ShouldRemoveComponent(Name: String): Boolean;
begin
  Result := ExistingInnoInstall and PreviousComponentSelected(Name) and
            (not WizardIsComponentSelected(Name));
end;

function GetServiceInstallParameters(Param: String): String;
begin
  if VDDResultCode = 0 then
    Result := ''
  else
    Result := '--no-start';
end;

function ShouldConfigureServiceAutostart(): Boolean;
begin
  Result := (VDDResultCode <> 101) and (not ServiceVerifyFailed);
end;

procedure InstallAndVerifyVDD();
var
  ResultCode: Integer;
  Params, Detail: String;
begin
  if not VDDComponentSelected() then
    Exit;

  WizardForm.StatusLabel.Caption := CustomMessage('StatusInstallVDD');
  EmitInstallerEvent('install-vdd', 'running', 'StatusInstallVDD', 0);
  Params := '--preserve-healthy-existing';
  ResultCode := -1;
  if not Exec(ExpandConstant('{app}\scripts\install-vdd.bat'), Params, '',
              SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    VDDResultCode := 101;
    Log('Could not launch the VDD installer helper.');
  end
  else if ResultCode = 0 then
  begin
    Log('VDD installation and control-interface verification succeeded.');
    EmitInstallerEvent('install-vdd', 'done', 'StatusInstallVDD', 0);
  end
  // 3010 only comes with a real Windows restart signal (vdd-device-helper.ps1 Get-VddWindowsRestartSignal:
  // ERROR_SUCCESS_REBOOT_REQUIRED from the bind or staging, CM_PROB_NEED_RESTART, DEVPKEY_Device_IsRebootRequired).
  // A device that is bound but not ready in time without one makes the helper exit 1: VDDResultCode 101 below, the
  // engine exits 101 and the shell shows the driver failure page with 修复安装.
  else if ResultCode = 3010 then
  begin
    VDDResultCode := 3010;
    Log('VDD installation requires a Windows restart; Sunshine will not start in this boot.');
    EmitInstallerEvent('install-vdd', 'needs-reboot', 'StatusInstallVDD', 3010);
  end
  else
  begin
    VDDResultCode := 101;
    Log('VDD installation or verification failed with exit code ' + IntToStr(ResultCode) + '.');
    EmitInstallerEvent('install-vdd', 'failed', 'StatusInstallVDD', 101);
  end;

  // the exit code of the helper itself (-1: it could not be started), not the 101 this script maps it to
  JournalComponent('vdd', 'install', ResultCode);

  if (VDDResultCode = 101) and (not WizardSilent) then
  begin
    Detail := CustomMessage('MsgVDDInstallFailed') + #13#10 + #13#10 +
              'Exit code: ' + IntToStr(ResultCode);
    InstallerMessageBox(Detail, mbError, MB_OK, IDOK);
  end;
end;

procedure InitializeWizard();
var
  WelcomeLeft: Integer;
begin
  InstallRunDir := InstallerParameterValue('SUNSHINE_RUN_DIR');
  InstallRunId := InstallerParameterValue('SUNSHINE_RUN_ID');
  InstallEventSequence := 0;
  PreviousVersion := '';
  if not RegQueryStringValue(HKLM32, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{B16E5C0D-7B8A-4E3B-9F1A-2D4C6E8F0A1B}_is1', 'DisplayVersion', PreviousVersion) then
    PreviousVersion := '';
  EmitInstallerEvent('wizard', 'running', 'WizardStarted', 0);
  // ── Main form tweaks ──
  WizardForm.Color := $FAF6F2;

  // ── Header panel (top bar on inner pages) — brand color ──
  WizardForm.MainPanel.Color := $C07020;
  WizardForm.PageNameLabel.Font.Color := $FFFFFF;
  WizardForm.PageNameLabel.Font.Size := 11;
  WizardForm.PageNameLabel.Font.Style := [fsBold];
  WizardForm.PageDescriptionLabel.Font.Color := $F0E0D0;
  WizardForm.PageDescriptionLabel.Font.Size := 9;

  // ── Welcome page — full brand makeover ──
  WelcomeLeft := WizardForm.WelcomeLabel1.Left;

  // Welcome heading
  WizardForm.WelcomeLabel1.Font.Name := 'Segoe UI';
  WizardForm.WelcomeLabel1.Font.Color := $0060C0;
  WizardForm.WelcomeLabel1.Font.Size := 16;
  WizardForm.WelcomeLabel1.Font.Style := [fsBold];

  // Welcome body text
  WizardForm.WelcomeLabel2.Font.Name := 'Segoe UI';
  WizardForm.WelcomeLabel2.Font.Color := $333333;
  WizardForm.WelcomeLabel2.Font.Size := 9;

  // ── License page ──
  WizardForm.LicenseMemo.Font.Name := 'Consolas';
  WizardForm.LicenseMemo.Font.Size := 9;
  WizardForm.LicenseMemo.Color := $FFFFFF;

  // ── Components page ──
  WizardForm.ComponentsList.Color := $FFFFFF;
  WizardForm.TypesCombo.Color := $FFFFFF;

  // ── Directory page ──
  WizardForm.DirEdit.Color := $FFFFFF;

  // ── Ready page memo ──
  WizardForm.ReadyMemo.Font.Name := 'Segoe UI';
  WizardForm.ReadyMemo.Font.Size := 9;
  WizardForm.ReadyMemo.Color := $FFFFFF;

  // ── Progress page ──
  WizardForm.StatusLabel.Font.Name := 'Segoe UI';
  WizardForm.StatusLabel.Font.Color := $444444;
  WizardForm.ProgressGauge.Top := WizardForm.ProgressGauge.Top;

  // ── Finish page — brand style ──
  WizardForm.FinishedHeadingLabel.Font.Name := 'Segoe UI';
  WizardForm.FinishedHeadingLabel.Font.Color := $0060C0;
  WizardForm.FinishedHeadingLabel.Font.Size := 16;
  WizardForm.FinishedHeadingLabel.Font.Style := [fsBold];
  WizardForm.FinishedLabel.Font.Name := 'Segoe UI';
  WizardForm.FinishedLabel.Font.Color := $333333;
  WizardForm.FinishedLabel.Font.Size := 9;

  // ── Inner page background ──
  WizardForm.InnerPage.Color := $F5F2EF;

  // ── Bottom button panel styling ──
  WizardForm.NextButton.Font.Size := 9;
  WizardForm.BackButton.Font.Size := 9;
  WizardForm.CancelButton.Font.Size := 9;

  // ── Create accent bar below header ──
  AccentBar := TBevel.Create(WizardForm);
  AccentBar.Parent := WizardForm.InnerPage;
  AccentBar.Shape := bsTopLine;
  AccentBar.Left := 0;
  AccentBar.Top := 0;
  AccentBar.Width := WizardForm.InnerPage.Width;
  AccentBar.Height := 3;

  // ── Create brand panel on Welcome page (right side overlay) ──
  BrandPanel := TPanel.Create(WizardForm);
  BrandPanel.Parent := WizardForm.WelcomeLabel1.Parent;
  BrandPanel.Left := WelcomeLeft;
  BrandPanel.Top := WizardForm.WelcomeLabel2.Top + WizardForm.WelcomeLabel2.Height + 20;
  BrandPanel.Width := WizardForm.WelcomeLabel1.Width;
  BrandPanel.Height := 90;
  BrandPanel.Color := $F0E8E0;
  BrandPanel.BevelOuter := bvNone;
  BrandPanel.ParentBackground := False;

  // Version info in brand panel  
  BrandTitle := TNewStaticText.Create(WizardForm);
  BrandTitle.Parent := BrandPanel;
  BrandTitle.Left := 16;
  BrandTitle.Top := 12;
  BrandTitle.Caption := 'Foundation Game Streaming Server';
  BrandTitle.Font.Name := 'Segoe UI';
  BrandTitle.Font.Size := 10;
  BrandTitle.Font.Color := $0060C0;
  BrandTitle.Font.Style := [fsBold];

  BrandSubtitle := TNewStaticText.Create(WizardForm);
  BrandSubtitle.Parent := BrandPanel;
  BrandSubtitle.Left := 16;
  BrandSubtitle.Top := 38;
  BrandSubtitle.Caption := 'v' + '{#MyAppVersion}' + '  |  Open Source  |  Low-latency';
  BrandSubtitle.Font.Name := 'Segoe UI';
  BrandSubtitle.Font.Size := 9;
  BrandSubtitle.Font.Color := $666666;

  // URL link in brand panel
  BrandLogo := TBitmapImage.Create(WizardForm);
  BrandLogo.Parent := BrandPanel;
  BrandLogo.Left := 16;
  BrandLogo.Top := 60;
  // Use as a visual separator line effect (reuse the bitmap component for placement)
end;

// Check if old NSIS installation exists and offer to uninstall
function DetectOldNSISInstall(): Boolean;
var
  UninstallString: String;
begin
  Result := False;
  // Check for NSIS uninstall registry entry
  if RegQueryStringValue(HKLM, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine',
    'UninstallString', UninstallString) then
  begin
    Result := True;
  end;
  // Also check WOW6432Node
  if not Result then
  begin
    if RegQueryStringValue(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine',
      'UninstallString', UninstallString) then
    begin
      Result := True;
    end;
  end;
end;

function GetOldNSISUninstallString(): String;
var
  UninstallString: String;
begin
  Result := '';
  if RegQueryStringValue(HKLM, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine',
    'UninstallString', UninstallString) then
  begin
    Result := UninstallString;
  end
  else if RegQueryStringValue(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine',
    'UninstallString', UninstallString) then
  begin
    Result := UninstallString;
  end;
end;

// Strip the executable path out of an UninstallString that may include
// surrounding quotes and/or trailing arguments (e.g. '"...\Uninstall.exe" /S').
function GetOldNSISUninstallExe(UninstallString: String): String;
var
  Path: String;
  ClosePos, SpacePos: Integer;
begin
  Path := Trim(UninstallString);
  if Path = '' then
  begin
    Result := '';
    Exit;
  end;
  if Path[1] = '"' then
  begin
    ClosePos := Pos('"', Copy(Path, 2, Length(Path) - 1));
    if ClosePos > 0 then
      Path := Copy(Path, 2, ClosePos - 1)
    else
      Path := Copy(Path, 2, Length(Path) - 1);
  end
  else
  begin
    SpacePos := Pos(' ', Path);
    if SpacePos > 0 then
      Path := Copy(Path, 1, SpacePos - 1);
  end;
  Result := Path;
end;

// Best-effort: extract the install directory from the NSIS UninstallString.
function GetOldNSISInstallDir(UninstallString: String): String;
var
  Path: String;
  SlashPos: Integer;
begin
  Result := '';
  Path := GetOldNSISUninstallExe(UninstallString);
  if Path = '' then
    Exit;
  SlashPos := Length(Path);
  while (SlashPos > 0) and (Path[SlashPos] <> '\') and (Path[SlashPos] <> '/') do
    SlashPos := SlashPos - 1;
  if SlashPos > 1 then
    Result := Copy(Path, 1, SlashPos - 1);
end;

// Force-delete the NSIS uninstall registry entries left behind by an old
// installation. Used as a fallback when the silent uninstall finishes but
// the registry still claims the product is installed (or when the install
// directory is already gone).
function CleanupOldNSISRegistry(): Boolean;
begin
  RegDeleteKeyIncludingSubkeys(HKLM, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine');
  RegDeleteKeyIncludingSubkeys(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine');
  Result := not DetectOldNSISInstall();
end;

// Read previous install directory from registry
function GetPreviousInstallDir(Default: String): String;
var
  InstallDir: String;
  Found: Boolean;
begin
  Result := Default;
  Found := RegQueryStringValue(HKLM64, 'SOFTWARE\AlkaidLab\Sunshine', 'InstallDir', InstallDir);
  // Fall back to HKLM32 for legacy 32-bit installs that wrote into Wow6432Node.
  if not Found then
    Found := RegQueryStringValue(HKLM32, 'SOFTWARE\AlkaidLab\Sunshine', 'InstallDir', InstallDir);
  if not Found or (InstallDir = '') then
    Exit;
  if DirExists(InstallDir) and
     FileExists(AddBackslash(InstallDir) + '{#MyAppExeName}') then
  begin
    Result := InstallDir;
    Exit;
  end;
  // Silent-mode safety net (auto-update path):
  // The GUI updater launches us with /VERYSILENT (no dir page, no user
  // interaction). If the previous sunshine.exe is missing (user deleted/moved
  // it, AV quarantine, etc.) but the registry still points at a real
  // directory, prefer that directory over falling back to {autopf}\Sunshine
  // so the silent auto-update reliably overwrites the original location
  // instead of creating a duplicate install in Program Files.
  if WizardSilent and DirExists(InstallDir) then
    Result := InstallDir;
end;

procedure DeleteInstallDirRegistry();
begin
  // The HKLM64 InstallDir value is also covered by [Registry] uninsdeletevalue,
  // but we explicitly clean HKLM32 legacy values (older installs may have
  // written there) and prune empty parent keys regardless of the user's
  // "keep data" choice.
  RegDeleteValue(HKLM64, 'SOFTWARE\AlkaidLab\Sunshine', 'InstallDir');
  RegDeleteValue(HKLM32, 'SOFTWARE\AlkaidLab\Sunshine', 'InstallDir');
  RegDeleteKeyIfEmpty(HKLM64, 'SOFTWARE\AlkaidLab\Sunshine');
  RegDeleteKeyIfEmpty(HKLM32, 'SOFTWARE\AlkaidLab\Sunshine');
  RegDeleteKeyIfEmpty(HKLM64, 'SOFTWARE\AlkaidLab');
  RegDeleteKeyIfEmpty(HKLM32, 'SOFTWARE\AlkaidLab');
end;

function DetectExistingInnoInstall(): Boolean;
var
  InstallDir: String;
begin
  Result := RegQueryStringValue(HKLM64, 'SOFTWARE\AlkaidLab\Sunshine', 'InstallDir', InstallDir);
  if not Result then
    Result := RegQueryStringValue(HKLM32, 'SOFTWARE\AlkaidLab\Sunshine', 'InstallDir', InstallDir);
  Result := Result and (InstallDir <> '') and DirExists(InstallDir);
end;

// The install folder is below Program Files: it inherits that folder's protection (Users read and execute only) and needs none of its own.
function IsUnderProgramFiles(Dir: String): Boolean;
var
  Lower: String;
begin
  Lower := Lowercase(AddBackslash(RemoveBackslash(Dir)));
  Result := (Pos(Lowercase(AddBackslash(ExpandConstant('{commonpf64}'))), Lower) = 1) or
            (Pos(Lowercase(AddBackslash(ExpandConstant('{commonpf32}'))), Lower) = 1);
end;

function RunIcacls(Params: String): Boolean;
var
  ResultCode: Integer;
begin
  ResultCode := -1;
  Result := Exec(ExpandConstant('{sys}\icacls.exe'), Params, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
  Log('icacls ' + Params + ' -> ' + IntToStr(ResultCode));
end;

// Setup is a 32-bit process, so a pointer is a Cardinal here. SetNamedSecurityInfoW replaces the whole DACL of a folder at once (and propagates it to what is in it).
function ConvertStringSecurityDescriptorToSecurityDescriptorW(StringSD: String; Revision: Cardinal; var SD: Cardinal; var SDSize: Cardinal): Integer;
  external 'ConvertStringSecurityDescriptorToSecurityDescriptorW@advapi32.dll stdcall';
function GetSecurityDescriptorDacl(SD: Cardinal; var Present: Integer; var Dacl: Cardinal; var Defaulted: Integer): Integer;
  external 'GetSecurityDescriptorDacl@advapi32.dll stdcall';
function SetNamedSecurityInfoW(ObjectName: String; ObjectType, SecurityInfo: Cardinal; Owner, Group, Dacl, Sacl: Cardinal): Cardinal;
  external 'SetNamedSecurityInfoW@advapi32.dll stdcall';
function LocalFree(Mem: Cardinal): Cardinal;
  external 'LocalFree@kernel32.dll stdcall';

// The DACL of the install folder, in SDDL (the same text as kProtectedSddl in tools/installer_dir_win.h):
//   D:P  protected (nothing inherited);  SYSTEM, Administrators, NT SERVICE\TrustedInstaller: full control;  Users and ALL APPLICATION PACKAGES: read and execute;
//   every entry for the folder and everything in it (OICI).
function ProtectedDaclSddl(): String;
begin
  Result := 'D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FA;;;S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464)(A;OICI;0x1200a9;;;BU)(A;OICI;0x1200a9;;;AC)';
end;

// Replace the whole DACL: whatever was on the folder before (an entry for the person who made it, which a CREATOR OWNER entry of the parent leaves behind and which
// "remove inheritance" does not touch; Everyone; Authenticated Users; older grants) is gone, not merely outnumbered.
// Authority: installer-ms-setnamedsecurityinfow-20261119, installer-ms-convertstringsecuritydescriptor-20261119.
function SetProtectedDacl(Dir: String): Boolean;
var
  Descriptor, Size, Dacl: Cardinal;
  Present, Defaulted: Integer;
  Status: Cardinal;
begin
  Result := False;
  Descriptor := 0;
  Size := 0;
  Dacl := 0;
  Present := 0;
  Defaulted := 0;
  if ConvertStringSecurityDescriptorToSecurityDescriptorW(ProtectedDaclSddl(), 1, Descriptor, Size) = 0 then
  begin
    Log('SDDL for the install folder could not be converted.');
    Exit;
  end;
  if (GetSecurityDescriptorDacl(Descriptor, Present, Dacl, Defaulted) <> 0) and (Present <> 0) then
  begin
    // SE_FILE_OBJECT = 1; DACL_SECURITY_INFORMATION = 4 or PROTECTED_DACL_SECURITY_INFORMATION = $80000000
    Status := SetNamedSecurityInfoW(Dir, 1, $80000004, 0, 0, Dacl, 0);
    Log('SetNamedSecurityInfo ' + Dir + ' -> ' + IntToStr(Status));
    Result := Status = 0;
  end;
  LocalFree(Descriptor);
end;

// The permissions of a folder into the installer log: what a support report needs to see when the protection is in doubt.
procedure LogFolderPermissions(Tag, Dir: String);
var
  ResultCode, I: Integer;
  OutFile: String;
  Lines: TArrayOfString;
begin
  OutFile := ExpandConstant('{tmp}\sunshine-folder-acl.txt');
  DeleteFile(OutFile);
  if Exec(ExpandConstant('{cmd}'), '/c ""' + ExpandConstant('{sys}\icacls.exe') + '" "' + Dir + '" > "' + OutFile + '" 2>&1"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and
     LoadStringsFromFile(OutFile, Lines) then
    for I := 0 to GetArrayLength(Lines) - 1 do
      if Trim(Lines[I]) <> '' then
        Log(Tag + ': ' + Lines[I]);
  DeleteFile(OutFile);
end;

// Whether the folder already holds anything: files of someone else, or what an uninstall that kept the person's settings left (the config folder).
function DirHasContent(Dir: String): Boolean;
var
  Find: TFindRec;
begin
  Result := False;
  if FindFirst(AddBackslash(Dir) + '*', Find) then
  begin
    try
      repeat
        if (Find.Name <> '.') and (Find.Name <> '..') then
        begin
          Result := True;
          Break;
        end;
      until not FindNext(Find);
    finally
      FindClose(Find);
    end;
  end;
end;

// The service runs the programs of the install folder as SYSTEM, so no ordinary user may be able to replace one. Program Files is protected by inheritance; any other folder
// inherits whatever its parent gives, and below the root of a data drive that is "Authenticated Users: Modify". The folder is therefore given the same protection as Program
// Files: the owner is Administrators and the DACL is replaced by ProtectedDaclSddl (Microsoft's well-known SIDs; the SIDs are used because the group names are localized).
// The setup shell's worker creates the folder with this DACL in the first place (installer_dir_win.h); this makes the same true when the engine runs on its own, for an
// existing install in a folder that older setups left open, and again after every update. An existing folder that is not the registered install (files of someone else) gets
// the owner and the permissions of everything in it reset first, because the owner of a file can always change its permissions (the config folder of the previous install
// is reset like that and gets its own permissions back from migrate-config.bat).
// Authority: installer-ms-icacls-20261119 (/setowner, /reset, *SID), installer-ms-takeown-20261119, installer-ms-well-known-sids-20261119.
function HardenInstallDir(): String;
var
  Dir, Registered, Quoted: String;
  Foreign, HasContent: Boolean;
  ResultCode: Integer;
begin
  Result := '';
  Dir := RemoveBackslash(ExpandConstant('{app}'));
  if IsUnderProgramFiles(Dir) then
    Exit;
  Quoted := '"' + Dir + '"';
  if not DirExists(Dir) then
    if not ForceDirectories(Dir) then
    begin
      Log('Install folder could not be created: ' + Dir);
      Result := CustomMessage('MsgDirProtectFailed');
      Exit;
    end;
  Registered := '';
  if not RegQueryStringValue(HKLM64, 'SOFTWARE\AlkaidLab\Sunshine', 'InstallDir', Registered) then
    Registered := '';
  HasContent := DirHasContent(Dir);
  Foreign := (CompareText(RemoveBackslash(Registered), Dir) <> 0) and HasContent;
  // The folder itself is protected before anything inside it is touched, and stays so: the content is handled below it, never by a reset that would hand the folder
  // back to what its parent grants.
  if not (RunIcacls(Quoted + ' /setowner *S-1-5-32-544 /C /Q') and SetProtectedDacl(Dir)) then
  begin
    Result := CustomMessage('MsgDirProtectFailed');
    Exit;
  end;
  if Foreign then
  begin
    // not an install of ours that is being updated: take what is in it over (owner Administrators, for the whole tree)
    ResultCode := -1;
    if not Exec(ExpandConstant('{sys}\takeown.exe'), '/F ' + Quoted + ' /R /A /D Y', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) or (ResultCode <> 0) then
    begin
      Log('takeown of the install folder failed: ' + IntToStr(ResultCode));
      Result := CustomMessage('MsgDirProtectFailed');
      Exit;
    end;
  end;
  // everything inside takes its permissions from the folder again: an entry that somebody gave to a program or a folder of the install (an older setup, a person) is gone.
  // "Dir\*" is what is in the folder: the folder itself is not reset.
  if HasContent and not RunIcacls('"' + AddBackslash(Dir) + '*" /reset /T /C /Q') then
  begin
    Result := CustomMessage('MsgDirProtectFailed');
    Exit;
  end;
  Log('Install folder protected like Program Files: ' + Dir);
  LogFolderPermissions('after protecting', Dir);
end;

function ShouldRepairInstallPermissions(): Boolean;
var
  ResultCode: Integer;
  VerifyLog, Params: String;
begin
  Result := False;
  if not ExistingInnoInstall then
    Exit;
  // Outside Program Files "reset to inherited" would hand the folder to whatever its parent grants: HardenInstallDir keeps it protected instead.
  if not IsUnderProgramFiles(ExpandConstant('{app}')) then
    Exit;

  // Verification is read-only and substantially cheaper than rewriting every
  // ACL. Only legacy installs with malformed/non-canonical ACLs take the slow
  // recursive reset path.
  VerifyLog := ExpandConstant('{tmp}\sunshine-icacls-verify.log');
  Params := '/c ""' + ExpandConstant('{sys}\icacls.exe') + '" "' + ExpandConstant('{app}') +
            '" /verify /T /C > "' + VerifyLog + '" 2>&1"';
  ResultCode := -1;
  if not Exec(ExpandConstant('{cmd}'), Params, '', SW_HIDE,
              ewWaitUntilTerminated, ResultCode) then
    Result := True
  else
    Result := ResultCode <> 0;

  if not Result then
    DeleteFile(VerifyLog);
end;

// The UTF-16 code of every character, for the log when two paths that look the same do not match.
function StringCodes(Value: String): String;
var
  I: Integer;
begin
  Result := '';
  for I := 1 to Length(Value) do
    Result := Result + IntToStr(Ord(Value[I])) + ' ';
end;

procedure ReportVerifiedService();
begin
  if ServiceStartFailed then
  begin
    EmitInstallerEvent('service', 'failed', 'StatusInstallService', 100);
    if not WizardSilent then
      InstallerMessageBox(CustomMessage('MsgServiceStartFailed'), mbError, MB_OK, IDOK);
  end
  else
    EmitInstallerEvent('service', 'done', 'StatusInstallService', 0);
end;

procedure VerifyServiceInstalled();
var
  ExpectedPath, ImagePath, Lower, Detail, TmpFile, Line: String;
  Tries, ResultCode, i: Integer;
  Found: Boolean;
  Lines: TArrayOfString;
begin
  EmitInstallerEvent('service', 'running', 'StatusInstallService', 0);
  ResultCode := TakeStepResult('service');
  // The batch reserves 2 for a start failure after successful configuration.
  // Still verify the service path before applying the autostart choice.
  ServiceStartFailed := ResultCode = 2;
  if ServiceStartFailed then
  begin
    Log('Service configuration succeeded, but starting it failed (script exit 2).');
    JournalComponent('service', 'start', ResultCode);
  end;
  if (ResultCode <> 0) and (not ServiceStartFailed) then
  begin
    Detail := 'Service script exit: ' + IntToStr(ResultCode);
    Log('Service installation failed. ' + Detail);
    ServiceVerifyFailed := True;
    EmitInstallerEvent('service', 'failed', 'StatusInstallService', 100);
    JournalComponent('service', 'install', ResultCode);
    if not WizardSilent then
      InstallerMessageBox(ExpandConstant(CustomMessage('MsgServiceInstallFailed')) + #13#10 + #13#10 + Detail, mbError, MB_OK, IDOK);
    Exit;
  end;
  ExpectedPath := ExpandConstant('{app}\tools\sunshinesvc.exe');
  Lower := Lowercase(ExpectedPath);

  // Read the service binary path directly from the registry instead of
  // parsing `sc qc` output. `sc.exe` localizes its column labels
  // (e.g. on Spanish Windows BINARY_PATH_NAME becomes NOMBRE_RUTA_BINARIO),
  // so the previous string-prefix match falsely failed on non-English
  // locales even though install-service.bat had already verified the
  // binPath via locale-safe `find /I <abs_path>` and exited 0.
  //
  // ImagePath is REG_EXPAND_SZ and may be wrapped in quotes when the path
  // contains spaces (it always does under "Program Files"); substring match
  // tolerates both forms, plus any future appended arguments.
  //
  // Retry a few times: SCM can take a moment to publish ImagePath after a
  // successful `sc create`, especially when the service was just deleted
  // out of "marked for deletion" state inside install-service.bat.
  //
  // The Services tree under HKLM\SYSTEM is shared between registry views. Use
  // HKLM first so the check is not sensitive to Inno/Windows 64-bit view
  // quirks, then fall back to HKLM64 for existing installers' behaviour.
  ImagePath := '';
  Found := False;
  for Tries := 1 to 5 do
  begin
    Found := RegQueryStringValue(HKLM, 'SYSTEM\CurrentControlSet\Services\SunshineService',
                                 'ImagePath', ImagePath);
    if not Found then
      Found := RegQueryStringValue(HKLM64, 'SYSTEM\CurrentControlSet\Services\SunshineService',
                                   'ImagePath', ImagePath);
    // exact first: the value was written from this very path, and a path with Chinese or other non-ASCII characters has to match as it is
    if Found and ((Pos(ExpectedPath, ImagePath) > 0) or (Pos(Lower, Lowercase(ImagePath)) > 0)) then
    begin
      ReportVerifiedService();
      Exit;  // happy path
    end;
    Sleep(500);
  end;
  if Found then
    Log('Service ImagePath does not contain the expected path. Expected codes: ' + StringCodes(ExpectedPath) + ' ImagePath codes: ' + StringCodes(ImagePath));

  // Last-resort verification: query SCM and look for the expected absolute
  // path anywhere in the output. This remains locale-safe because we do not
  // parse localized labels such as BINARY_PATH_NAME/NOMBRE_RUTA_BINARIO.
  TmpFile := ExpandConstant('{tmp}\sc_qc_sunshineservice_verify.txt');
  ResultCode := -1;
  Exec(ExpandConstant('{cmd}'), '/c ""' + ExpandConstant('{sys}\sc.exe') + '" qc SunshineService > "' + TmpFile + '" 2>&1"',
       '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  if (ResultCode = 0) and LoadStringsFromFile(TmpFile, Lines) then
  begin
    for i := 0 to GetArrayLength(Lines) - 1 do
    begin
      Line := Lines[i];
      if (Pos(ExpectedPath, Line) > 0) or (Pos(Lower, Lowercase(Line)) > 0) then
      begin
        DeleteFile(TmpFile);
        ReportVerifiedService();
        Exit;
      end;
    end;
  end;
  DeleteFile(TmpFile);

  // Build a detailed diagnostic so support reports include the actual
  // mismatch rather than just the generic "could not install or verify"
  // string. This makes it obvious whether the registry is empty (sc create
  // never ran / was blocked) vs. pointing at an old install directory
  // (stale SCM record from a previous install on a different drive).
  if not Found then
    Detail := 'ImagePath: <missing>'
  else
    Detail := 'ImagePath: ' + ImagePath;
  Detail := Detail + #13#10 + 'Expected: ' + ExpectedPath;
  Detail := Detail + #13#10 + 'sc qc exit: ' + IntToStr(ResultCode);
  // Warn, but do NOT Abort(). Aborting here rolls the whole installation back
  // and leaves {app} holding nothing but the preserved `config` directory —
  // a total loss for what is usually a recoverable condition (SunshineService
  // still "marked for deletion" from the previous uninstall, a stale binPath
  // pointing at an old install drive, SCM being slow to publish ImagePath).
  // The files are fine; only the service registration needs another attempt,
  // which scripts\install-service.bat, the GUI's repair action, or a reboot
  // can all do. Keep the install and tell the user how to retry.
  //
  // The exit code still reports the failure — see GetCustomSetupExitCode().
  ServiceVerifyFailed := True;
  EmitInstallerEvent('service', 'failed', 'StatusInstallService', 100);
  JournalComponent('service', 'verify', 100);
  Log('Service verification failed. ' + Detail);
  // Silent callers receive the failure through the exit code and log above.
  // CustomMessage() returns the string verbatim, so {app} needs ExpandConstant.
  if not WizardSilent then
    InstallerMessageBox(ExpandConstant(CustomMessage('MsgServiceInstallFailed')) + #13#10 + #13#10 + Detail, mbError, MB_OK, IDOK);
end;

procedure VerifyServiceAutostart();
var
  StartType: Cardinal;
  Found: Boolean;
  Detail: String;
  ResultCode: Integer;
begin
  StartType := 0;
  ResultCode := TakeStepResult('autostart');
  Found := RegQueryDWordValue(HKLM, 'SYSTEM\CurrentControlSet\Services\SunshineService', 'Start', StartType);
  if not Found then
    Found := RegQueryDWordValue(HKLM64, 'SYSTEM\CurrentControlSet\Services\SunshineService', 'Start', StartType);
  if (ResultCode = 0) and Found and (StartType = 2) then
  begin
    EmitInstallerEvent('autostart', 'done', 'StatusAutostart', 0);
    Exit;
  end;
  if Found then
    Detail := 'Start: ' + IntToStr(StartType)
  else
    Detail := 'Start: <missing>';
  Detail := 'Autostart script exit: ' + IntToStr(ResultCode) + #13#10 + Detail;
  Log('Service autostart verification failed. ' + Detail);
  ServiceVerifyFailed := True;
  EmitInstallerEvent('autostart', 'failed', 'StatusAutostart', 100);
  JournalComponent('autostart', 'verify', 100);
  if not WizardSilent then
    InstallerMessageBox(CustomMessage('MsgServiceAutostartFailed') + #13#10 + #13#10 + Detail, mbError, MB_OK, IDOK);
end;

// Report a nonzero exit code when the service could not be verified. Inno
// returns 0 on a completed install, and callers such as the GUI's auto-updater
// (`/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-`, success := code = 0) would
// otherwise report a broken install as successful. Codes 100/101 are outside
// Inno's own range (1-8), while 3010 is the standard Windows reboot-required
// result consumed by unattended updaters.
procedure AddRebootReason(Name: String);
begin
  if Pos(Name, RebootReasons) = 0 then
  begin
    if RebootReasons <> '' then
      RebootReasons := RebootReasons + ',';
    RebootReasons := RebootReasons + Name;
  end;
end;

// A restart is requested only when a driver step returned 3010, or Windows itself reports a pending
// restart on one of our drivers. The decision and its reasons go to the event log ('reboot').
procedure DecideRestart();
var
  ResultCode: Integer;
  OutFile, Names: String;
  Lines: TArrayOfString;
  I: Integer;
begin
  if RebootChecked then
    Exit;
  RebootChecked := True;
  RebootReasons := '';
  if VDDResultCode = 3010 then
    AddRebootReason('vdd');
  if GamepadResult = 3010 then
    AddRebootReason('vigem');
  if UsbipResult = 3010 then
    AddRebootReason('usbip');
  OutFile := ExpandConstant('{tmp}\sunshine-reboot-check.txt');
  DeleteFile(OutFile);
  if FileExists(ExpandConstant('{app}\tools\driver-reboot-check.ps1')) then
  begin
    if Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
            '-NoProfile -ExecutionPolicy Bypass -File "' + ExpandConstant('{app}\tools\driver-reboot-check.ps1') + '" -Out "' + OutFile + '"',
            '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and LoadStringsFromFile(OutFile, Lines) then
    begin
      for I := 0 to GetArrayLength(Lines) - 1 do
      begin
        Names := Trim(Lines[I]);
        if Pos('vdd', Names) > 0 then AddRebootReason('vdd');
        if Pos('vigem', Names) > 0 then AddRebootReason('vigem');
        if Pos('vmouse', Names) > 0 then AddRebootReason('vmouse');
        if Pos('usbip', Names) > 0 then AddRebootReason('usbip');
      end;
    end;
  end;
  if RebootReasons = '' then
  begin
    Log('Restart decision: not needed.');
    EmitInstallerEvent('reboot', 'done', 'none', 0);
  end
  else
  begin
    Log('Restart decision: needed for ' + RebootReasons + '.');
    EmitInstallerEvent('reboot', 'done', RebootReasons, 3010);
  end;
end;

function GetCustomSetupExitCode(): Integer;
begin
  DecideRestart();
  if VDDResultCode = 101 then
    Result := 101
  else if ServiceVerifyFailed or ServiceStartFailed then
    Result := 100
  else if RebootReasons <> '' then
    Result := 3010
  else
    Result := 0;
end;

// ---- Programs that were moved aside so nothing could start them ----------------------------------
// update-quiesce.ps1 -Park renames the host, the service and the tray to <name>.parked once they
// have been ended: a supervisor that starts the tray again a moment later finds nothing to start.
// Setup then installs the new files and the old ones are deleted; when it does not finish (the
// rollback removes the new files it created) they are put back, so a failed update leaves the
// programs that were there. Authority: installer-inno-renamefile-20261119.
function PreparedDir(): String;
begin
  if UpdateAppDir <> '' then
    Result := UpdateAppDir
  else
    Result := ExpandConstant('{app}');
end;

function ParkedImage(const Relative: String): String;
begin
  Result := PreparedDir() + '\' + Relative + '.parked';
end;

function LiveImage(const Relative: String): String;
begin
  Result := PreparedDir() + '\' + Relative;
end;

// At the start of a run: a run that was killed after parking left the old program under the other
// name. Put it back when the real name is empty, drop it when a program is there again.
procedure RecoverParkedImage(const Relative: String);
begin
  if not FileExists(ParkedImage(Relative)) then
    Exit;
  if FileExists(LiveImage(Relative)) then
    DeleteFile(ParkedImage(Relative))
  else if RenameFile(ParkedImage(Relative), LiveImage(Relative)) then
    Log('Restored ' + Relative + ' left aside by an earlier update.')
  else
    Log('Could not restore ' + Relative + ' left aside by an earlier update.');
end;

procedure RecoverParkedImages();
begin
  RecoverParkedImage('sunshine.exe');
  RecoverParkedImage('tools\sunshinesvc.exe');
  RecoverParkedImage('assets\gui\sunshine-gui.exe');
end;

// At the end of a run (and when an update is refused): keep the new program and delete the old
// one, or put the old one back in place of whatever the failed run left.
procedure SettleParkedImage(const Relative: String; const Installed: Boolean);
begin
  if not FileExists(ParkedImage(Relative)) then
    Exit;
  if Installed and FileExists(LiveImage(Relative)) then
    DeleteFile(ParkedImage(Relative))
  else
  begin
    if FileExists(LiveImage(Relative)) then
      DeleteFile(LiveImage(Relative));
    if RenameFile(ParkedImage(Relative), LiveImage(Relative)) then
      Log('The update did not finish; ' + Relative + ' was put back.')
    else
      Log('The update did not finish and ' + Relative + ' could not be put back.');
  end;
end;

procedure SettleParkedImages(const Installed: Boolean);
begin
  SettleParkedImage('sunshine.exe', Installed);
  SettleParkedImage('tools\sunshinesvc.exe', Installed);
  SettleParkedImage('assets\gui\sunshine-gui.exe', Installed);
end;

// ---- The Web UI folder is replaced as one unit that can be put back ----------------------------
// Setup rolls a failed installation back by removing what it created. It does not bring back a
// file it overwrote or a folder an [InstallDelete] entry removed, so deleting assets\web up front
// left an update that failed later with no Web UI at all. The old folder is moved aside instead
// (a rename on the same volume), the new one is copied in, and the old one is deleted only once the
// installation has finished. Authority: installer-inno-installdelete-20261119 ([InstallDelete]
// runs as the first step of the installation), installer-inno-script-events-20261107
// (PrepareToInstall, CurStepChanged, DeinitializeSetup), installer-inno-renamefile-20261119
// (also renames a directory), installer-inno-deltree-20261119, installer-inno-exit-codes-20261119
// (a text returned by PrepareToInstall ends Setup in the Preparing to Install stage, exit code 7),
// installer-inno-closeapplications-20261119 (the Restart Manager check that follows it).
function WebUiDir(): String;
begin
  Result := PreparedDir() + '\assets\web';
end;

function WebUiBackupDir(): String;
begin
  Result := PreparedDir() + '\assets\web.previous';
end;

// A Web UI folder is complete when the installer that copied it got to its end: the marker is
// written after the last file. Two pages are not enough, they are copied first.
function WebUiIsComplete(const Dir: String): Boolean;
begin
  Result := FileExists(Dir + '\.install-complete');
end;

// Put the old folder back when the live one was not finished: an earlier run was stopped (killed,
// powered off) between moving it aside and finishing. False when it cannot be put back; then the
// update must not go on, because the next step would delete the only complete copy.
function RecoverWebUi(): Boolean;
begin
  Result := True;
  if not DirExists(WebUiBackupDir()) then
    Exit;
  if WebUiIsComplete(WebUiDir()) then
  begin
    DelTree(WebUiBackupDir(), True, True, True);
    WebUiMovedAside := False;
    Exit;
  end;
  if DirExists(WebUiDir()) then
    if not DelTree(WebUiDir(), True, True, True) then
    begin
      Log('Could not remove the unfinished Web UI folder of an earlier update.');
      Result := False;
      Exit;
    end;
  if RenameFile(WebUiBackupDir(), WebUiDir()) then
  begin
    // nothing is aside any more: a later refusal must not delete what was put back
    WebUiMovedAside := False;
    Log('Restored the Web UI folder left aside by an earlier update.');
  end
  else
  begin
    Log('Could not restore the Web UI folder left aside by an earlier update.');
    Result := False;
  end;
end;

// False when the old folder cannot be moved aside (something holds a handle of it): the update must
// stop, or a failed copy would have nothing to put back.
function BackUpWebUi(): Boolean;
begin
  Result := True;
  if not DirExists(WebUiDir()) then
    Exit;
  if DirExists(WebUiBackupDir()) then
    DelTree(WebUiBackupDir(), True, True, True);
  if RenameFile(WebUiDir(), WebUiBackupDir()) then
    WebUiMovedAside := True
  else
  begin
    Log('The Web UI folder could not be moved aside.');
    Result := False;
  end;
end;

// The installer got to its end: the marker says the folder holds every file of this version.
procedure MarkWebUiComplete();
begin
  if DirExists(WebUiDir()) then
    if not SaveStringToFile(WebUiDir() + '\.install-complete', 'complete', False) then
    begin
      // every file was copied; a refused marker must not make Setup put the old folder back over them
      WebUiMarkerFailed := True;
      Log('The Web UI completion marker could not be written.');
    end;
end;

// Called from DeinitializeSetup, which runs after a rollback ("Deinitializing Setup." follows
// "Uninstallation process succeeded." in the Setup log).
procedure FinishWebUiBackup();
begin
  if not WebUiMovedAside then
    Exit;
  if PostInstallReached and (WebUiIsComplete(WebUiDir()) or WebUiMarkerFailed) then
  begin
    DelTree(WebUiBackupDir(), True, True, True);
    Log('The new Web UI folder is in place; the old one was deleted.');
  end
  else
  begin
    if DirExists(WebUiDir()) then
      DelTree(WebUiDir(), True, True, True);
    if RenameFile(WebUiBackupDir(), WebUiDir()) then
      Log('The installation did not finish; the previous Web UI folder was put back.')
    else
      Log('The installation did not finish and the previous Web UI folder could not be put back.');
  end;
  WebUiMovedAside := False;
end;

procedure DeinitializeSetup();
begin
  // A run that was cancelled before PrepareToInstall prepared a folder owns nothing to settle.
  if UpdateAppDir <> '' then
  begin
    FinishWebUiBackup();
    SettleParkedImages(PostInstallReached);
  end;
  EmitInstallerEvent('installer', 'done', 'InstallerFinished', GetCustomSetupExitCode());
end;

// Initialization: handle old NSIS upgrade
function InitializeSetup(): Boolean;
var
  UninstallString: String;
  UninstallExe: String;
  InstallDir: String;
  Params: String;
  ResultCode: Integer;
  Waited: Integer;
begin
  ExistingInnoInstall := DetectExistingInnoInstall();
  Result := True;

  if not DetectOldNSISInstall() then
    Exit;

  UninstallString := GetOldNSISUninstallString();
  if UninstallString = '' then
    Exit;

  UninstallExe := GetOldNSISUninstallExe(UninstallString);
  InstallDir := GetOldNSISInstallDir(UninstallString);

  // If the uninstaller binary itself is gone, the registry entry is just stale
  // metadata. Offer to clean it up rather than blocking the install entirely.
  if (UninstallExe = '') or (not FileExists(UninstallExe)) then
  begin
    // Without interactive consent, preserve old installation metadata and stop.
    if InstallerMessageBox(CustomMessage('MsgOldNSISStaleRegistry'), mbConfirmation, MB_YESNO, IDNO) = IDYES then
    begin
      if not CleanupOldNSISRegistry() then
      begin
        InstallerMessageBox(CustomMessage('MsgOldNSISCleanupFailed'), mbError, MB_OK, IDOK);
        Result := False;
      end;
    end
    else
    begin
      Result := False;
    end;
    Exit;
  end;

  // Do not silently run an older uninstaller that could remove user data.
  if InstallerMessageBox(CustomMessage('MsgOldNSISDetected'), mbConfirmation, MB_YESNO, IDNO) <> IDYES then
  begin
    Result := False;
    Exit;
  end;

  // NSIS silent uninstall quirk: with bare '/S' the uninstaller copies itself
  // to %TEMP% and re-launches a detached process, so ewWaitUntilTerminated
  // returns almost immediately while the real cleanup is still running. Pass
  // '_?=<InstallDir>' so the uninstaller runs in-place and we actually wait.
  Params := '/S';
  if (InstallDir <> '') and DirExists(InstallDir) then
    Params := Params + ' _?=' + InstallDir;

  Exec(UninstallExe, Params, '', SW_HIDE, ewWaitUntilTerminated, ResultCode);

  // Poll for up to ~60 seconds in case the uninstaller still detached or its
  // post-uninstall steps (firewall/service/driver scripts) take a while.
  Waited := 0;
  while DetectOldNSISInstall() and (Waited < 60) do
  begin
    Sleep(1000);
    Waited := Waited + 1;
  end;

  if not DetectOldNSISInstall() then
    Exit;

  // Still detected. If the install directory is empty/gone, the uninstaller
  // succeeded at removing files but failed to delete its own registry key
  // (a known NSIS issue when launched with _?=). Offer to clean it up so
  // the user is not stuck in an unrecoverable state.
  if (InstallDir = '') or (not DirExists(InstallDir)) or
     (not FileExists(UninstallExe)) then
  begin
    if InstallerMessageBox(CustomMessage('MsgOldNSISStaleRegistry'), mbConfirmation, MB_YESNO, IDNO) = IDYES then
    begin
      if not CleanupOldNSISRegistry() then
      begin
        InstallerMessageBox(CustomMessage('MsgOldNSISCleanupFailed'), mbError, MB_OK, IDOK);
        Result := False;
      end;
      Exit;
    end;
  end;

  InstallerMessageBox(CustomMessage('MsgOldNSISFailed'), mbError, MB_OK, IDOK);
  Result := False;
end;

// Stop services and processes before installation to avoid locked files
// The installer shell passes its own pid so an installer package that is itself called
// Sunshine.exe is not stopped together with the installed Sunshine.
function SunshineKillParameters(): String;
var
  ShellPid: String;
  I: Integer;
  Digits: Boolean;
begin
  Result := '/f /im sunshine.exe';
  ShellPid := InstallerParameterValue('SUNSHINE_SHELL_PID');
  Digits := ShellPid <> '';
  for I := 1 to Length(ShellPid) do
    if (ShellPid[I] < '0') or (ShellPid[I] > '9') then
      Digits := False;
  if Digits then
    Result := Result + ' /fi "PID ne ' + ShellPid + '"';
end;

// ---- Make the folder safe to update ------------------------------------------------------------
// update-quiesce.ps1 stops the service, ends what still runs from the folder (repeatedly, since a
// tray can be started again a moment after it was ended) and checks that no file of the folder is
// held. It returns 0 when ready; the report says what is in the way otherwise.
function RunUpdateQuiesce(const VerifyOnly: Boolean; var Report: String): Integer;
var
  Script, ReportFile, Params: String;
  ResultCode: Integer;
  Lines: TArrayOfString;
  I: Integer;
begin
  Result := -1;
  Report := '';
  if not UpdateScriptExtracted then
  begin
    ExtractTemporaryFile('update-quiesce.ps1');
    UpdateScriptExtracted := True;
  end;
  Script := ExpandConstant('{tmp}\update-quiesce.ps1');
  ReportFile := ExpandConstant('{tmp}\update-quiesce-report.txt');
  DeleteFile(ReportFile);
  Params := '-NoProfile -ExecutionPolicy Bypass -File "' + Script + '" -Root "' + PreparedDir() +
    '" -Report "' + ReportFile + '" -Park';
  if VerifyOnly then
    Params := Params + ' -VerifyOnly';
  if not Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'), Params, '', SW_HIDE,
    ewWaitUntilTerminated, ResultCode) then
  begin
    Log('The update preparation script could not be started: ' + SysErrorMessage(ResultCode));
    Exit;
  end;
  Result := ResultCode;
  if LoadStringsFromFile(ReportFile, Lines) then
    for I := 0 to GetArrayLength(Lines) - 1 do
    begin
      Log('update-quiesce: ' + Lines[I]);
      if Report <> '' then
        Report := Report + #13#10;
      Report := Report + Lines[I];
      // the service was running when this script came, or the Control Panel's updater had stopped it
      if (Pos('service: stopping', Lines[I]) = 1) or (Pos('updater: ended', Lines[I]) = 1) then
        ServiceStoppedForUpdate := True;
    end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  CleanupScript, CleanupRoot, CleanupParameters, Report: String;
  ResultCode, QuiesceCode: Integer;
begin
  Result := '';
  EmitInstallerEvent('prepare', 'running', 'PrepareToInstall', 0);
  // before anything is copied or started in the install folder
  Result := HardenInstallDir();
  if Result <> '' then
    Exit;
  // The person went back and chose another folder: what was prepared in the first one goes back.
  if (UpdateAppDir <> '') and (CompareText(UpdateAppDir, ExpandConstant('{app}')) <> 0) then
  begin
    FinishWebUiBackup();
    SettleParkedImages(False);
  end;
  UpdateAppDir := ExpandConstant('{app}');
  if not RecoverWebUi() then
  begin
    Result := FmtMessage(CustomMessage('MsgUpdateBlocked'), ['assets\web.previous (the Web UI folder of an earlier update could not be put back)']);
    Exit;
  end;
  RecoverParkedImages();

  ExtractTemporaryFile('cleanup-legacy-ds5.ps1');
  CleanupScript := ExpandConstant('{tmp}\cleanup-legacy-ds5.ps1');
  CleanupRoot := ExpandConstant('{app}\tools\sunshine-ds5-component');
  CleanupParameters := '-NoProfile -ExecutionPolicy Bypass -File "' + CleanupScript +
    '" -Root "' + CleanupRoot + '"';
  // Scope process/service/task/firewall cleanup to the old component tree;
  // the shared USB/IP driver remains available to native DualSense.
  if not Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'), CleanupParameters,
    '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    Log('Legacy DualSense cleanup script could not be started.')
  else if ResultCode <> 0 then
    Log('Legacy DualSense cleanup script returned ' + IntToStr(ResultCode) + '.');
  // Stop everything that runs from the install folder and make sure nothing holds a file of it.
  // A tray the Control Panel's own updater left running, or one started again a moment after it
  // was ended, used to hold sunshine-gui.exe; the copy then failed in the middle of the update.
  // Refusing here changes nothing: the installation is exactly what it was.
  QuiesceCode := RunUpdateQuiesce(False, Report);
  if QuiesceCode > 0 then
  begin
    Log('The install folder cannot be updated now (code ' + IntToStr(QuiesceCode) + ').');
    EmitInstallerEvent('prepare', 'failed', 'UpdateBlocked', QuiesceCode);
    // the programs moved aside go back first: the service is started from them
    SettleParkedImages(False);
    if ServiceStoppedForUpdate then
      Exec(ExpandConstant('{sys}\net.exe'), 'start SunshineService', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    Result := FmtMessage(CustomMessage('MsgUpdateBlocked'), [Report]);
    Exit;
  end;
  if QuiesceCode < 0 then
  begin
    // Without the script, stop the service and end the programs by name as earlier versions did.
    Exec(ExpandConstant('{sys}\net.exe'), 'stop SunshineService', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    Exec(ExpandConstant('{sys}\taskkill.exe'), SunshineKillParameters(), '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    Exec(ExpandConstant('{sys}\taskkill.exe'), '/f /im sunshine-gui.exe', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    Exec(ExpandConstant('{sys}\taskkill.exe'), '/f /im sunshinesvc.exe', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  end;
  // The old Web UI folder is moved aside now, while a refusal still costs nothing; if it cannot be
  // moved, nothing could be put back after a failed copy, so the update stops here.
  if not BackUpWebUi() then
  begin
    EmitInstallerEvent('prepare', 'failed', 'UpdateBlocked', 20);
    Result := FmtMessage(CustomMessage('MsgUpdateBlocked'), ['held: assets\web (the folder could not be moved aside)']);
    SettleParkedImages(False);
    if ServiceStoppedForUpdate then
      Exec(ExpandConstant('{sys}\net.exe'), 'start SunshineService', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    Exit;
  end;
  if FileExists(ExpandConstant('{app}\tools\mat-capture\sunshine-plugin-mat-capture.exe')) then
  begin
    if not Exec(ExpandConstant('{app}\tools\mat-capture\sunshine-plugin-mat-capture.exe'),
      '--wait-for-stop', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) or (ResultCode <> 0) then
    begin
      Result := 'MAT capture is still stopping. Retry installation after it exits.';
      Exit;
    end;
  end;
  // Small delay to allow processes to release files
  Sleep(1000);
end;

// Clean up portable scripts during install
procedure CurStepChanged(CurStep: TSetupStep);
var
  Report: String;
begin
  if CurStep = ssInstall then
  begin
    // The files are about to be copied. What ran between the preparation and now (the Restart
    // Manager check, a supervisor starting a tray again) is ended once more, and if the folder
    // still cannot be updated Setup stops before it has changed anything.
    if RunUpdateQuiesce(True, Report) > 0 then
      if RunUpdateQuiesce(False, Report) > 0 then
        RaiseException(FmtMessage(CustomMessage('MsgUpdateBlocked'), [Report]));
    JournalStart();
    EmitInstallerEvent('plan', 'running', PlannedInstallerSteps(), 0);
    InstallProgressPermille := -20;
    EmitInstallerEvent('install', 'running', 'InstallStarted', 0);
  end;
  if CurStep = ssPostInstall then
  begin
    PostInstallReached := True;
    MarkWebUiComplete();
    // Upgrade older VDDs and make driver readiness a hard gate before the
    // Sunshine service is allowed to start. A bound-but-not-ready device is
    // kept for Windows to finish during the requested reboot.
    InstallAndVerifyVDD();
    if not IsUnderProgramFiles(ExpandConstant('{app}')) then
      LogFolderPermissions('after install', RemoveBackslash(ExpandConstant('{app}')));
    // Delete portable scripts in installed version
    DeleteFile(ExpandConstant('{app}\install_portable.bat'));
    DeleteFile(ExpandConstant('{app}\uninstall_portable.bat'));
    EmitInstallerEvent('install', 'done', 'InstallFinished', GetCustomSetupExitCode());
    // a service that was verified is reported as done (a failure was reported where it was found)
    if not ServiceVerifyFailed then
      JournalComponent('service', 'verify', 0);
    JournalFinish(GetCustomSetupExitCode());
  end;
end;

function NeedRestart(): Boolean;
begin
  DecideRestart();
  Result := RebootReasons <> '';
end;

// Custom uninstall: ask about gamepad and data removal
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  ResultCode: Integer;
begin
  if CurUninstallStep = usUninstall then
  begin
    // The driver may be shared with other applications; silence must keep it.
    if InstallerMessageBox(CustomMessage('MsgUninstallGamepad'), mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES then
    begin
      Exec(ExpandConstant('{app}\scripts\uninstall-gamepad.bat'), '', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    end;
  end;

  if CurUninstallStep = usPostUninstall then
  begin
    // InstallDir is installer state, not user data. Always remove it so a failed
    // installation cannot lock future installs to a stale drive/path.
    DeleteInstallDirRegistry();

    // Only explicit consent may delete configuration, paired clients and covers.
    // An unattended uninstall keeps user data, even without /SUPPRESSMSGBOXES.
    if InstallerMessageBox(FmtMessage(CustomMessage('MsgUninstallData'), [ExpandConstant('{app}')]),
      mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES then
    begin
      DelTree(ExpandConstant('{app}'), True, True, True);
    end;
  end;
end;

// Use previous installation directory as default
function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
end;
