; Sunshine Inno Setup Script
; Generated from CMake template - DO NOT EDIT DIRECTLY
; Edit cmake/packaging/sunshine.iss.in instead

#define MyAppName "@CMAKE_PROJECT_NAME@"
#define MyAppVersion "@CPACK_PACKAGE_VERSION@"
#define MyAppPublisher "@CPACK_PACKAGE_VENDOR@"
#define MyAppURL "@CMAKE_PROJECT_HOMEPAGE_URL@"
#define MyAppExeName "@CMAKE_PROJECT_NAME@.exe"
#define MyAppGUIExeName "sunshine-gui.exe"
#define MySourceDir "@INNO_STAGING_DIR@"
#define MyIconFile "@CMAKE_SOURCE_DIR@\assets\brand\sunshine.ico"
#define MyWelcomeBmp "@CMAKE_SOURCE_DIR@\assets\installer\welcome.bmp"
#define MySmallBmp "@CMAKE_SOURCE_DIR@\assets\installer\wizard_small.bmp"
#define MyLicenseFile "@CMAKE_SOURCE_DIR@\LICENSE"

[Setup]
; 基本设置
AppId={{B16E5C0D-7B8A-4E3B-9F1A-2D4C6E8F0A1B}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName=Foundation Sunshine Game Streaming Server v{#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}/support
AppUpdatesURL={#MyAppURL}
DefaultDirName={code:GetPreviousInstallDir|{autopf}\{#MyAppName}}
; Always show the directory page so users can recover from a bad remembered path.
DisableDirPage=no
DefaultGroupName={#MyAppName}
; 管理员权限。Sunshine 必须以管理员安装：写 HKLM 注册表、安装服务/驱动/防火墙、
; 写入 {autopf}\Sunshine 都需要提权。不允许用户在 UAC 对话框中降级到 "为当前用户安装"，
; 否则 HKLM\SOFTWARE\AlkaidLab\Sunshine 会以错误 5 (拒绝访问) 失败。
PrivilegesRequired=admin
; 输出设置
OutputDir=@CPACK_PACKAGE_DIRECTORY@
; The Inno engine is embedded in the native shell after compilation.
OutputBaseFilename=Sunshine-engine
; 压缩
; Same method and dictionary as before (lzma2/ultra64, solid). The payload is about 120 MB; with 64 MB blocks the compressor
; started a new stream at every block, so a file in the second block could not match the first. One block (the largest the
; directive allows, 256 MB) and the maximum fast-byte count remove that split: measured on the same build, installer
; 44,918,301 -> 44,381,565 bytes (-1.2 %). Only the compressor changes: the installer unpacks the same 64 MB dictionary
; sequentially either way, so installation time and memory do not change. The price is build time (the Package step 33 s -> 45 s
; on a hosted runner), because one block is compressed by one thread. The compressor runs in its own 64-bit process (the
; 32-bit compiler process ran out of memory with several ultra64 block threads).
; https://jrsoftware.org/ishelp/index.php?topic=setup_lzmanumblockthreads
; https://jrsoftware.org/ishelp/index.php?topic=setup_lzmablocksize
; https://jrsoftware.org/ishelp/index.php?topic=setup_lzmauseseparateprocess
Compression=lzma2/ultra64
SolidCompression=yes
LZMANumBlockThreads=1
LZMABlockSize=262144
LZMANumFastBytes=273
LZMAUseSeparateProcess=yes
; UI 设置
SetupIconFile={#MyIconFile}
UninstallDisplayIcon={app}\{#MyAppExeName}
WizardStyle=modern hidebevels
WizardImageFile={#MyWelcomeBmp}
WizardSmallImageFile={#MySmallBmp}
WizardImageAlphaFormat=defined
WizardSizePercent=120
; 版本信息 (VersionInfoVersion requires X.X.X.X format, use AppVersion for display)
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription=Foundation Sunshine Game Streaming Server
VersionInfoProductName={#MyAppName}
; 其他
LicenseFile={#MyLicenseFile}
; Updates must reuse the registered application directory. The shell validates the
; directory first, and this directive keeps silent and interactive engine runs on
; the same path as the existing installation.
UsePreviousAppDir=yes
; Preserve the previous type and component selection for /SILENT and /VERYSILENT
; updates when the shell does not pass an explicit /COMPONENTS list.
UsePreviousSetupType=yes
; 最小 Windows 版本 (Windows 10)
MinVersion=10.0
; 64 位安装
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; 重启管理器
CloseApplications=yes
RestartApplications=yes
; Driver installation is executed from [Code], where its exit status is
; validated. NeedRestart() requests the reboot only after a staged VDD reports
; that its device/control interface cannot become ready in the current boot.
RestartIfNeededByRun=no
; Always write %TEMP%\Setup Log*.txt. Support reports for "service did not
; install" / "files disappeared" are unanswerable without the per-file and
; per-[Run] results, and users cannot be expected to re-run with /LOG.
SetupLogging=yes
UninstallLogging=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesesimplified"; MessagesFile: "@CMAKE_SOURCE_DIR@\cmake\packaging\ChineseSimplified.isl"

