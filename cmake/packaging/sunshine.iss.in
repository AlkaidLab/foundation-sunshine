chinesesimplified.StatusStoppingProcesses=正在停止 Sunshine 进程...

[Types]
Name: "recommended"; Description: "{cm:TypeRecommended}"
Name: "full"; Description: "{cm:TypeFull}"
Name: "compact"; Description: "{cm:TypeCompact}"
Name: "custom"; Description: "{cm:TypeCustom}"; Flags: iscustom

[Components]
Name: "application"; Description: "{cm:ComponentApplication}"; Types: recommended full compact custom; Flags: fixed
Name: "assets"; Description: "{cm:ComponentAssets}"; Types: recommended full compact custom; Flags: fixed
Name: "gui"; Description: "{cm:ComponentGUI}"; Types: recommended full compact custom; Flags: fixed
; Per-component minimum Windows 10 builds (docs/windows-compatibility.md): the VDD packages are UMDF 2.25 / IddCx 1.2
; (Windows 10 1803, 17134), usbip-win2 needs Windows 10 1903 (18362). Below that the component is not offered.
Name: "vdd"; Description: "{cm:ComponentVDD} — {cm:ComponentVDDDesc}"; Types: recommended full; ExtraDiskSpaceRequired: 2097152; MinVersion: 10.0.17134
Name: "firewall"; Description: "{cm:ComponentFirewall} — {cm:ComponentFirewallDesc}"; Types: recommended full compact
Name: "autostart"; Description: "{cm:ComponentAutostart} — {cm:ComponentAutostartDesc}"; Types: recommended full
Name: "gamepad"; Description: "{cm:ComponentGamepad} — {cm:ComponentGamepadDesc}"; Types: recommended full
Name: "usbip"; Description: "{cm:ComponentUsbip} — {cm:ComponentUsbipDesc}"; Types: full; MinVersion: 10.0.18362
Name: "vmouse"; Description: "{cm:ComponentVmouse} — {cm:ComponentVmouseDesc}"; Types: full
Name: "tools"; Description: "{cm:ComponentTools} — {cm:ComponentToolsDesc}"; Types: recommended full

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[InstallDelete]
; The old hashed Web UI bundles are not deleted here: [InstallDelete] runs as the first step of
; the installation and is not undone when Setup is rolled back, so a failed update would leave
; the folder missing. BackUpWebUi() moves it aside instead, and removes it once the update has
; finished. Authority: installer-inno-installdelete-20261119.
; The native GUI plugin replaces the legacy standalone diagnostic executable.
Type: files; Name: "{app}\tools\stylus-input-probe.exe"
; Earlier RTX adapter builds placed the complete VC runtime beside Sunshine.
Type: files; Name: "{app}\msvcp140*.dll"
Type: files; Name: "{app}\vcruntime140*.dll"
Type: files; Name: "{app}\concrt140.dll"
; The native DualSense path supersedes the optional legacy sidecar. The
; upgrade hook below stops integrations that point into this tree first.
Type: filesandordirs; Name: "{app}\tools\sunshine-ds5-component"
Type: files; Name: "{app}\tools\ds5-sidecar-package.json"
Type: files; Name: "{app}\Sunshine.Ds5Sidecar.manifest.json"
; These files now live in licenses\libwebp. Preserve any unrelated files.
Type: files; Name: "{app}\tools\library\libwebp\LICENSE.txt"
Type: files; Name: "{app}\tools\library\libwebp\PATENTS.txt"
Type: dirifempty; Name: "{app}\tools\library\libwebp"
Type: dirifempty; Name: "{app}\tools\library"

[Files]
; Embedded only for PrepareToInstall; it is not part of the installed layout.
Source: "{#MySourceDir}\scripts\cleanup-legacy-ds5.ps1"; DestDir: "{tmp}"; Flags: dontcopy
Source: "{#MySourceDir}\scripts\update-quiesce.ps1"; DestDir: "{tmp}"; Flags: dontcopy
; Main application
Source: "{#MySourceDir}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\zlib1.dll"; DestDir: "{app}"; Flags: ignoreversion; Components: application
; Source: inno-setup-files-20261117.
Source: "{#MySourceDir}\NOTICE"; DestDir: "{app}"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\LICENSE"; DestDir: "{app}"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\licenses\*"; DestDir: "{app}\licenses"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: application

; Mandatory tools
Source: "{#MySourceDir}\tools\sunshinesvc.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\tools\qiin-tabtip.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: application
#if @SUNSHINE_MAT_CAPTURE_AVAILABLE@
Source: "{#MySourceDir}\tools\mat-capture\sunshine-plugin-mat-capture.exe"; DestDir: "{app}\tools\mat-capture"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\tools\mat-capture\*.dll"; DestDir: "{app}\tools\mat-capture"; Flags: onlyifdoesntexist uninsrestartdelete; Components: application
Source: "{#MySourceDir}\tools\mat-capture\LICENSE.MinHook.txt"; DestDir: "{app}\tools\mat-capture"; Flags: ignoreversion; Components: application
#endif
Source: "{#MySourceDir}\tools\nefconw.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: application
; the protocol launcher of the Sparxie touch applications (published from tools/sparxie-launch when the build has dotnet)
Source: "{#MySourceDir}\tools\sparxie-launch.exe"; DestDir: "{app}\tools"; Flags: ignoreversion skipifsourcedoesntexist; Components: application

; Optional HDR adapter shipped with Sunshine. List first-party files explicitly
; so a stale local staging directory cannot add a vendor runtime to the package.
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_rtx_video\foundation_rtx_video_adapter.dll"; DestDir: "{app}\tools\hdr_enhanced\nvidia_rtx_video"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_rtx_video\README.md"; DestDir: "{app}\tools\hdr_enhanced\nvidia_rtx_video"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_rtx_video\RTX_VIDEO_THIRD_PARTY_NOTICES.md"; DestDir: "{app}\tools\hdr_enhanced\nvidia_rtx_video"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
; Optional DLSS NR adapter: first-party only, the NVIDIA runtime is never packaged.
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_dlssnr\foundation_dlssnr_adapter.dll"; DestDir: "{app}\tools\hdr_enhanced\nvidia_dlssnr"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_dlssnr\NVIDIA-DLSS-LICENSE.txt"; DestDir: "{app}\tools\hdr_enhanced\nvidia_dlssnr"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_dlssnr\NVIDIA-OPTICAL-FLOW-NOTICES.txt"; DestDir: "{app}\tools\hdr_enhanced\nvidia_dlssnr"; Flags: ignoreversion skipifsourcedoesntexist; Components: application

; Portable scripts (will be deleted during install, but needed for layout)
Source: "{#MySourceDir}\install_portable.bat"; DestDir: "{app}"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\uninstall_portable.bat"; DestDir: "{app}"; Flags: ignoreversion; Components: application

; Language files
Source: "{#MySourceDir}\scripts\languages\*"; DestDir: "{app}\scripts\languages"; Flags: ignoreversion recursesubdirs; Components: application

; Service scripts
Source: "{#MySourceDir}\scripts\install-service.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\scripts\uninstall-service.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\scripts\remove-shell-menus.ps1"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\scripts\sleep.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application

; Migration scripts
Source: "{#MySourceDir}\scripts\migrate-config.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\scripts\migrate-images.ps1"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\scripts\IMAGE_MIGRATION.md"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application

; PATH management
Source: "{#MySourceDir}\scripts\update-path.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application

; Assets (shaders, web UI, etc.)
Source: "{#MySourceDir}\assets\*"; DestDir: "{app}\assets"; Excludes: "gui\*"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: assets
; Chinese installs get the Chinese default menu command names. Sunshine copies
; assets\apps.json to the config folder on first start, and Moonlight clients
; show these names as-is.
Source: "{#MySourceDir}\assets\apps.zh.json"; DestDir: "{app}\assets"; DestName: "apps.json"; Languages: chinesesimplified; Flags: ignoreversion; Components: assets

; Required GUI and user-session tray agent
Source: "{#MySourceDir}\assets\gui\{#MyAppGUIExeName}"; DestDir: "{app}\assets\gui"; Flags: ignoreversion; Components: gui
Source: "{#MySourceDir}\assets\gui\alkaidlab-plugin-stylus.dll"; DestDir: "{app}\assets\gui"; Flags: ignoreversion; Components: gui
Source: "{#MySourceDir}\assets\gui\WebView2Loader.dll"; DestDir: "{app}\assets\gui"; Flags: ignoreversion skipifsourcedoesntexist; Components: gui

; Helper tools
Source: "{#MySourceDir}\tools\device-toggler.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: assets
Source: "{#MySourceDir}\tools\DevManView.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: assets
Source: "{#MySourceDir}\tools\restart64.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: assets
Source: "{#MySourceDir}\tools\SetDpi.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: assets
Source: "{#MySourceDir}\tools\usbip-win2-root.ps1"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: assets
Source: "{#MySourceDir}\tools\driver-reboot-check.ps1"; DestDir: "{app}\tools"; Flags: ignoreversion skipifsourcedoesntexist; Components: assets
Source: "{#MySourceDir}\tools\setreg.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: assets

; Autostart script
; Always copy so users can run it manually as admin if they unchecked autostart.
Source: "{#MySourceDir}\scripts\autostart-service.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion

; Firewall scripts
; Always copy so users can run them manually as admin if they unchecked firewall.
