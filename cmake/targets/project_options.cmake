include_guard(GLOBAL)

# Require the selected standard rather than silently accepting an older dialect.
set(CMAKE_CXX_STANDARD_REQUIRED ON)
option(SUNSHINE_TESTS_ENABLE_COVERAGE "Enable gcov coverage instrumentation for tests" OFF)

add_library(sunshine_project_options INTERFACE)
target_compile_features(sunshine_project_options INTERFACE cxx_std_23)
if(MINGW)
    target_link_options(sunshine_project_options INTERFACE -static)
    target_compile_options(sunshine_project_options INTERFACE $<$<COMPILE_LANGUAGE:RC>:--use-temp-file>)
endif()

add_library(sunshine_coverage INTERFACE)
if(SUNSHINE_TESTS_ENABLE_COVERAGE)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        message(FATAL_ERROR "SUNSHINE_TESTS_ENABLE_COVERAGE requires GCC or Clang")
    endif()
    target_compile_options(sunshine_coverage INTERFACE
            $<$<COMPILE_LANGUAGE:C,CXX>:--coverage;-g;-O0>)
    target_link_options(sunshine_coverage INTERFACE --coverage)
    if(MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        # Instrumented Beast templates can exceed the standard COFF section limit.
        target_compile_options(sunshine_coverage INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-Wa,-mbig-obj>)
    endif()
endif()

function(sunshine_finalize_directory directory)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_target IN LISTS _targets)
        get_target_property(_type "${_target}" TYPE)
        if(NOT _type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
            continue()
        endif()
        target_link_libraries("${_target}" PRIVATE sunshine_project_options)
        # Share only modules whose implementation has no SUNSHINE_TESTS variant.
        get_target_property(_sources "${_target}" SOURCES)
        foreach(_module IN ITEMS crypto ai_provider ai_stream)
            set(_library "sunshine_${_module}")
            get_target_property(_shared_sources "${_library}" SOURCES)
            if(_target STREQUAL _library)
                continue()
            endif()
            foreach(_source IN LISTS _shared_sources)
                if(_source IN_LIST _sources)
                    list(REMOVE_ITEM _sources "${_source}")
                    target_link_libraries("${_target}" PRIVATE "${_library}")
                endif()
            endforeach()
        endforeach()
        if(WIN32 AND NOT _target STREQUAL "sunshine_windows_resources")
            set(_resource "${PROJECT_BINARY_DIR}/windows.rc")
            if(_resource IN_LIST _sources)
                list(REMOVE_ITEM _sources "${_resource}")
                target_link_libraries("${_target}" PRIVATE sunshine_windows_resources)
            endif()
        endif()
        set_property(TARGET "${_target}" PROPERTY SOURCES "${_sources}")
        if(SUNSHINE_TESTS_ENABLE_COVERAGE AND
           (directory MATCHES "/tests($|/)" OR _target MATCHES "^sunshine_(http|crypto|ai_provider|ai_stream)$"))
            target_link_libraries("${_target}" PRIVATE sunshine_coverage)
        endif()
    endforeach()
    # Include owned nested test/tool targets without changing vendored projects.
    if(NOT directory STREQUAL PROJECT_SOURCE_DIR)
        get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
        foreach(_child IN LISTS _children)
            cmake_path(IS_PREFIX directory "${_child}" NORMALIZE _owned)
            if(_owned)
                sunshine_finalize_directory("${_child}")
            endif()
        endforeach()
    endif()
endfunction()

function(sunshine_finalize_project)
    sunshine_finalize_directory("${PROJECT_SOURCE_DIR}")
    if(WIN32)
        sunshine_finalize_directory("${PROJECT_SOURCE_DIR}/tools")
    endif()
    if(BUILD_TESTS OR BUILD_TRAY_TESTS)
        sunshine_finalize_directory("${PROJECT_SOURCE_DIR}/tests")
    endif()
endfunction()
