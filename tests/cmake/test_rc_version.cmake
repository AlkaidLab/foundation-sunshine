# cmake -P tests/cmake/test_rc_version.cmake: the binary FILEVERSION encoding (cmake/prep/rc_version.cmake).
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/prep/rc_version.cmake")

set(failures 0)
function(expect version expected)
    sunshine_rc_file_version(actual "${version}")
    if(NOT actual STREQUAL expected)
        message(SEND_ERROR "sunshine_rc_file_version(${version}) = ${actual}, expected ${expected}")
    endif()
    # every field of the result must fit 16 bits
    string(REPLACE "," ";" fields "${actual}")
    foreach(field IN LISTS fields)
        if(field GREATER 65535)
            message(SEND_ERROR "${version}: field ${field} of ${actual} does not fit 16 bits")
        endif()
    endforeach()
endfunction()

# the build-time form: HHMMSS above 65535 is split into HHMM and SS
expect("2026.1104.235959" "2026,1104,2359,59")
expect("2026.1104.121813" "2026,1104,1218,13")
expect("2026.0104.090500" "2026,104,905,0")
expect("2026.1231.000001" "2026,1231,0,1")
# the suffixes the version string carries keep the same binary version
expect("2026.1104.235959.96a1e2b6" "2026,1104,2359,59")
expect("2026.1104.235959.杂鱼" "2026,1104,2359,59")
expect("v2026.1104.235959.杂鱼" "2026,1104,2359,59")
# a plain numeric version whose parts fit is used as is
expect("1.2.3" "1,2,3,0")
expect("0.0.0" "0,0,0,0")
expect("2025.1.2.3" "2025,1,2,3")
# parts that do not fit, and versions that are not numeric, give 0,0,0,0
expect("1.2.70000" "0,0,0,0")
expect("1.2.123456789" "0,0,0,0")
expect("manual-20261104-121813-dev" "0,0,0,0")
expect("" "0,0,0,0")

# a later build time has a larger binary version. if(GREATER) compares as double, so compare the high and the
# low 32 bits (each exact in a double) instead of one 64-bit packed number.
function(later_than newer older)
    sunshine_rc_file_version(n "${newer}")
    sunshine_rc_file_version(o "${older}")
    string(REPLACE "," ";" n "${n}")
    string(REPLACE "," ";" o "${o}")
    list(GET n 0 n0)
    list(GET n 1 n1)
    list(GET n 2 n2)
    list(GET n 3 n3)
    list(GET o 0 o0)
    list(GET o 1 o1)
    list(GET o 2 o2)
    list(GET o 3 o3)
    math(EXPR nh "${n0} * 65536 + ${n1}")
    math(EXPR nl "${n2} * 65536 + ${n3}")
    math(EXPR oh "${o0} * 65536 + ${o1}")
    math(EXPR ol "${o2} * 65536 + ${o3}")
    if(NOT (nh GREATER oh OR (nh EQUAL oh AND nl GREATER ol)))
        message(SEND_ERROR "${newer} does not have a larger binary version than ${older}")
    endif()
endfunction()
later_than("2026.1104.235959" "2026.1104.235958")
later_than("2026.1105.000000" "2026.1104.235959")
later_than("2026.1104.120000" "2026.1104.115959")
later_than("2027.0101.000000" "2026.1231.235959")
