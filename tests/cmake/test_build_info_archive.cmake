# cmake -P tests/cmake/test_build_info_archive.cmake: a source tree made with git archive (no .git) still records its
# commit and branch from cmake/prep/build_identity_archive.txt (export-subst), and placeholders are ignored.
set(repo "${CMAKE_CURRENT_LIST_DIR}/../..")
get_filename_component(repo "${repo}" ABSOLUTE)
string(RANDOM LENGTH 8 suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/build-info-archive-${suffix}")
if(NOT CMAKE_CURRENT_BINARY_DIR)
    set(root "$ENV{TMP}/build-info-archive-${suffix}")
endif()

function(identity_of content out_commit out_branch out_dirty)
    file(REMOVE_RECURSE "${root}")
    file(MAKE_DIRECTORY "${root}/cmake/prep")
    file(WRITE "${root}/cmake/prep/build_identity_archive.txt" "${content}")
    set(CMAKE_SOURCE_DIR "${root}")
    set(CMAKE_MODULE_PATH "${repo}/cmake")
    set(PROJECT_VERSION "2026.1104.235959")
    unset(ENV{SUNSHINE_BUILD_COMMIT})
    unset(ENV{SUNSHINE_BUILD_BRANCH})
    unset(ENV{COMMIT})
    unset(ENV{BRANCH})
    # ${root} is not a repository, but it may sit inside one (the build directory of a checkout). GIT_DIR names a
    # directory that does not exist, so git reports "not a git repository" whatever the platform's handling of
    # GIT_CEILING_DIRECTORIES: the archive file is the only source.
    set(ENV{GIT_DIR} "${root}/no-git-dir")
    include("${repo}/cmake/prep/build_info.cmake")
    set(${out_commit} "${BUILD_INFO_COMMIT}" PARENT_SCOPE)
    set(${out_branch} "${BUILD_INFO_BRANCH}" PARENT_SCOPE)
    set(${out_dirty} "${BUILD_INFO_DIRTY}" PARENT_SCOPE)
endfunction()

set(sha "c05dc9a6500979afcf0097c619492399a55e2521")
identity_of("${sha}\nHEAD -> feat/build-identity, origin/feat/build-identity\n" commit branch dirty)
if(NOT commit STREQUAL sha OR NOT branch STREQUAL "feat/build-identity" OR NOT dirty STREQUAL "0")
    message(SEND_ERROR "archive: got ${commit} ${branch} dirty=${dirty}")
endif()
identity_of("${sha}\ntag: v2026.1104, master\n" commit branch dirty)
if(NOT branch STREQUAL "master")
    message(SEND_ERROR "archive with a tag first: branch ${branch}")
endif()
identity_of("${sha}\n\n" commit branch dirty)
if(NOT commit STREQUAL sha OR NOT branch STREQUAL "")
    message(SEND_ERROR "archive without refs: got ${commit} '${branch}'")
endif()
# a checkout keeps the placeholders: nothing is taken from them
identity_of("$Format:%H$\n$Format:%D$\n" commit branch dirty)
if(NOT commit STREQUAL "")
    message(SEND_ERROR "placeholders were read as a commit: ${commit}")
endif()
unset(ENV{GIT_DIR})
file(REMOVE_RECURSE "${root}")
