<Page
    x:Class="FoundationSunshineWidget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#1E1E20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock Text="Foundation Sunshine 串流仪表盘"
                       FontSize="18" FontWeight="SemiBold" Foreground="#EBEBEB"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
