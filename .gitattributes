# License texts are byte-for-byte copies from their upstream tags; the manifest
# pins their SHA-256, so checkout must not convert line endings.
third_party/licenses/**/LICENSE -text

# ensure dockerfiles are checked out with LF line endings
Dockerfile text eol=lf
*.dockerfile text eol=lf

# ensure flatpak lint json files are checked out with LF line endings
*flatpak-lint-*.json text eol=lf

# i18n formatting checks compare locale files byte-for-byte with LF output
src_assets/common/assets/web/public/assets/locale/*.json text eol=lf

# ensure Windows batch scripts are checked out with CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
# captured Windows file: CRLF line ends are part of the data
tests/sparxie/fixtures/sample-zzz-general-data-20261112.json -text whitespace=cr-at-eol

# Core patch context must match the LF source archive on Windows too.

# git archive writes the commit and its refs into this file (cmake/prep/build_info.cmake reads it when there is no .git)
cmake/prep/build_identity_archive.txt export-subst

# third-party licence texts keep their upstream bytes (their SHA-256 is pinned in third_party/licenses/manifest.json)
third_party/licenses/**/LICENSE -text
# The payload manifest hashes are shared with the component compatibility manifest.
scripts/packaging/usbip-payload.json text eol=lf
