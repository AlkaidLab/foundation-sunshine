{
  "name": "alkaidlab-foundation-sunshine",
  "private": true,
  "engines": {
    "node": ">=26.7.0 <27",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  },
  "type": "module",
  "scripts": {
    "prebuild": "node ./src_assets/common/assets/web/scripts/extract-welcome-locales.js",
    "build": "vite build --config scripts/vite/vite.config.js",
    "build-clean": "vite build --emptyOutDir --config scripts/vite/vite.config.js",
    "build:debug": "vite build --debug --config scripts/vite/vite.config.js",
    "dev": "vite build --watch --config scripts/vite/vite.config.js",
    "dev-server": "vite serve --config scripts/vite/vite.dev.config.js",
    "preview": "vite preview --config scripts/vite/vite.config.js",
    "preview:build": "npm run build && npm run preview",
    "lint:webui": "eslint \"src_assets/common/assets/web/**/*.{js,vue}\" --max-warnings 0",
    "test:webui": "node --test \"src_assets/common/assets/web/tests/*.test.js\"",
    "i18n:validate": "node scripts/validate-i18n.js",
    "i18n:sync": "node scripts/validate-i18n.js --sync",
    "i18n:reverse-sync": "node scripts/reverse-sync-i18n.js --sync",
    "i18n:reverse-check": "node scripts/reverse-sync-i18n.js",
    "i18n:format": "node scripts/format-i18n.js",
    "i18n:format:check": "node scripts/format-i18n.js --check"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@popperjs/core": "2.11.8",
    "bootstrap": "^5.3.8",
    "firebase": "^12.18.0",
    "marked": "^18.0.10",
    "nanoid": "^6.0.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.8",
    "vuedraggable-es": "^4.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "~10.10.0",
    "ejs": "^6.0.1",
    "globals": "^17.11.0",
    "less": "^4.9.0",
    "vite": "^8.2.2",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
